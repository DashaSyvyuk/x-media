APP_ENV=prod
APP_SECRET=5ea3114a349591bd131296e00f21c20a
APP_DEBUG=0

# Trust the docker nginx in front of php-fpm plus any RFC1918 proxy. If there
# is also a public-facing proxy (Cloudflare / ALB / host nginx) terminating
# TLS, override this in .env.prod.local with that proxy's IP/CIDR appended,
# e.g. "127.0.0.1,REMOTE_ADDR,private_ranges,203.0.113.10".
# Without this, X-Forwarded-Proto: https is ignored, the session cookie is
# issued without Secure, the browser drops it on the post-login redirect,
# and /admin bounces back to /admin/login.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR,private_ranges

# Web Push VAPID (admin notifications) — set real keys in .env.prod.local
# Generate: python/openssl or Minishlink\WebPush\VAPID::createVapidKeys()
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:x-media@x-media.com.ua
