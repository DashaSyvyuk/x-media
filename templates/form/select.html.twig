{% set prefix = formPrefix|default('RozetkaProduct') %}
<select id="{{ prefix }}_values_{{ valueId }}_values" name="{{ prefix }}[values][{{ valueId }}][value]" class="rozetka-characteristics-values form-select" >
    {% for value in values %}
        <option value="{{ value.id }}">{{ value.value }}</option>
    {% endfor %}
</select>
