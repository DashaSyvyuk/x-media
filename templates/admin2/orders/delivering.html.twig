{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}Доставляється — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/orders.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/fulfillment.css') }}">
{% endblock %}

{% block body %}
    <div class="fulfillment-page delivering-page">
        <div class="mb-4">
            <h1 class="page-title mb-1">Доставляється</h1>
            <p class="text-muted mb-0 small">Замовлення в дорозі — лише перегляд</p>
        </div>

        <div class="fulfillment-board delivering-board">
            <div class="fulfillment-column">
                <div class="fulfillment-column__header">
                    <h2>Курʼєр</h2>
                    <span class="badge text-bg-primary">{{ courierOrders|length }}</span>
                </div>
                <div class="fulfillment-column__list">
                    {% for order in courierOrders %}
                        {% include 'admin2/orders/_delivering_card.html.twig' with { order: order } %}
                    {% else %}
                        <div class="fulfillment-empty">Немає замовлень курʼєром</div>
                    {% endfor %}
                </div>
            </div>

            <div class="fulfillment-column">
                <div class="fulfillment-column__header">
                    <h2>Нова Пошта</h2>
                    <span class="badge text-bg-info">{{ novaPoshtaOrders|length }}</span>
                </div>
                <div class="fulfillment-column__list">
                    {% for order in novaPoshtaOrders %}
                        {% include 'admin2/orders/_delivering_card.html.twig' with { order: order } %}
                    {% else %}
                        <div class="fulfillment-empty">Немає відправлень НП</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
