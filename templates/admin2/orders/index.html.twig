{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/orders/_macros.html.twig' as order_macros %}

{% block title %}Замовлення — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/orders.css') }}">
{% endblock %}

{% block body %}
    {% set query = {
        q: search,
        status: status,
        dateFrom: dateFrom,
        dateTo: dateTo,
        sort: sort,
        dir: direction,
        perPage: perPage
    } %}
    {% set filtersActive = search or status or dateFrom or dateTo %}

    <div class="orders-page">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 page-header-row">
            <div>
                <h1 class="page-title mb-1">Замовлення</h1>
                <p class="text-muted mb-0 small">Керування замовленнями клієнтів</p>
            </div>
            <div class="page-header-actions">
                <a href="{{ path('admin2_orders_new') }}" class="btn btn-teal">
                    <i class="bi bi-plus-lg"></i> Нове замовлення
                </a>
            </div>
        </div>

        <div class="order-stat-grid">
            <div class="card order-stat-card order-stat-card--new">
                <div class="order-stat-card__body">
                    <div class="order-stat-card__label">Нові</div>
                    <div class="order-stat-card__value">{{ summary.new|number_format(0, '.', ' ') }}</div>
                </div>
            </div>
            <div class="card order-stat-card order-stat-card--progress">
                <div class="order-stat-card__body">
                    <div class="order-stat-card__label">В процесі</div>
                    <div class="order-stat-card__value">{{ summary.inProgress|number_format(0, '.', ' ') }}</div>
                </div>
            </div>
            <div class="card order-stat-card order-stat-card--shipped">
                <div class="order-stat-card__body">
                    <div class="order-stat-card__label">Відправлено</div>
                    <div class="order-stat-card__value">{{ summary.shipped|number_format(0, '.', ' ') }}</div>
                </div>
            </div>
            <div class="card order-stat-card order-stat-card--done">
                <div class="order-stat-card__body">
                    <div class="order-stat-card__label">Доставлено</div>
                    <div class="order-stat-card__value">{{ summary.completed|number_format(0, '.', ' ') }}</div>
                </div>
            </div>
            <div class="card order-stat-card order-stat-card--canceled">
                <div class="order-stat-card__body">
                    <div class="order-stat-card__label">Відмінено</div>
                    <div class="order-stat-card__value">{{ summary.canceled|number_format(0, '.', ' ') }}</div>
                </div>
            </div>
            <div class="card order-stat-card order-stat-card--sum">
                <div class="order-stat-card__body">
                    <div class="order-stat-card__label">Сума (фільтр)</div>
                    <div class="order-stat-card__value">{{ order_macros.money(summary.totalSum) }}</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm products-table-card">
            <div class="card-body orders-filters-wrap">
                <form method="get" action="{{ path('admin2_orders') }}" class="orders-filters">
                    <label class="orders-filters__search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search"
                               name="q"
                               value="{{ search }}"
                               placeholder="Номер, імʼя, телефон, email"
                               autocomplete="off">
                    </label>

                    <select name="status" class="orders-filters__status" aria-label="Статус">
                        <option value="">Усі статуси</option>
                        {% for value, label in statusChoices %}
                            <option value="{{ value }}" {{ status == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>

                    <div class="orders-filters__dates" role="group" aria-label="Період">
                        <input type="date" name="dateFrom" value="{{ dateFrom }}" aria-label="Дата від">
                        <span class="orders-filters__dates-sep" aria-hidden="true">→</span>
                        <input type="date" name="dateTo" value="{{ dateTo }}" aria-label="Дата до">
                    </div>

                    <select name="perPage" class="orders-filters__perpage" aria-label="На сторінці">
                        {% for option in perPageOptions %}
                            <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }}</option>
                        {% endfor %}
                    </select>

                    <input type="hidden" name="sort" value="{{ sort }}">
                    <input type="hidden" name="dir" value="{{ direction }}">

                    <div class="orders-filters__actions">
                        <button type="submit" class="btn btn-teal btn-sm">
                            <i class="bi bi-funnel"></i> Фільтр
                        </button>
                        {% if filtersActive %}
                            <a href="{{ path('admin2_orders') }}" class="btn btn-outline-secondary btn-sm" title="Скинути">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table products-table products-table--mobile-cards align-middle">
                    <thead>
                        <tr>
                            <th>{{ order_macros.sort_link('ID', 'id', sort, direction, query, 'admin2_orders') }}</th>
                            <th>{{ order_macros.sort_link('Номер', 'orderNumber', sort, direction, query, 'admin2_orders') }}</th>
                            <th>{{ order_macros.sort_link('Клієнт', 'surname', sort, direction, query, 'admin2_orders') }}</th>
                            <th>{{ order_macros.sort_link('Телефон', 'phone', sort, direction, query, 'admin2_orders') }}</th>
                            <th>{{ order_macros.sort_link('Статус', 'status', sort, direction, query, 'admin2_orders') }}</th>
                            <th>Оплата</th>
                            <th>{{ order_macros.sort_link('Сума', 'total', sort, direction, query, 'admin2_orders') }}</th>
                            <th>{{ order_macros.sort_link('Дата', 'createdAt', sort, direction, query, 'admin2_orders') }}</th>
                            <th style="width: 100px;" class="text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in pagination %}
                            <tr>
                                <td class="text-muted" data-label="ID">#{{ order.id }}</td>
                                <td data-label="Номер"><div class="product-title">{{ order.orderNumber }}</div></td>
                                <td data-label="Клієнт">
                                    <div class="product-title">{{ order.name }} {{ order.surname }}</div>
                                    {% if order.email %}
                                        <div class="product-title__meta d-none d-md-block">{{ order.email }}</div>
                                    {% endif %}
                                </td>
                                <td class="text-muted small" data-label="Телефон">{{ order.phone }}</td>
                                <td data-label="Статус">{{ order_macros.order_status_badge(order.status) }}</td>
                                <td data-label="Оплата">{{ order_macros.payment_status_badge(order.paymentStatus) }}</td>
                                <td data-label="Сума">{{ order_macros.money(order.total) }}</td>
                                <td class="small text-muted" data-label="Дата">{{ order.createdAt|date('d.m.Y H:i') }}</td>
                                <td class="text-end col-actions" data-label="">
                                    <div class="table-actions">
                                        <a href="{{ path('admin2_orders_edit', {id: order.id}) }}" class="table-action table-action--teal" title="Редагувати">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin2_orders_delete', {id: order.id}) ~ (app.request.queryString ? '?' ~ app.request.queryString : '') }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin2_order_action') }}">
                                            <button type="submit" class="table-action table-action--danger" title="Видалити" data-confirm="Видалити замовлення #{{ order.orderNumber|e('html_attr') }}?">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center text-muted py-5">
                                    <i class="bi bi-bag fs-2 d-block mb-2"></i>
                                    Замовлень не знайдено
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if pagination.getTotalItemCount() > 0 %}
                <div class="products-footer">
                    <div class="products-summary">
                        Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                        з {{ pagination.getTotalItemCount() }}
                    </div>
                    {% if pagination.pageCount > 1 %}
                        {% set currentPage = pagination.currentPageNumber %}
                        {% set pageCount = pagination.pageCount %}
                        {% set startPage = max(1, currentPage - 2) %}
                        {% set endPage = min(pageCount, currentPage + 2) %}
                        <ul class="products-pagination">
                            <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin2_orders', query|merge({page: currentPage - 1})) }}"><i class="bi bi-chevron-left"></i></a>
                            </li>
                            {% if startPage > 1 %}
                                {{ order_macros.page_link(pagination, 1, query, 'admin2_orders') }}
                                {% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                            {% endif %}
                            {% for page in startPage..endPage %}{{ order_macros.page_link(pagination, page, query, 'admin2_orders') }}{% endfor %}
                            {% if endPage < pageCount %}
                                {% if endPage < pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                                {{ order_macros.page_link(pagination, pageCount, query, 'admin2_orders') }}
                            {% endif %}
                            <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin2_orders', query|merge({page: currentPage + 1})) }}"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.closest('form')?.addEventListener('submit', (event) => {
                if (!window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
{% endblock %}
