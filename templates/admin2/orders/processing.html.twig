{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}Обробка замовлень — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/orders.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/fulfillment.css') }}">
{% endblock %}

{% block body %}
    <div class="fulfillment-page processing-page">
        <div class="mb-4">
            <h1 class="page-title mb-1">Обробка</h1>
            <p class="text-muted mb-0 small">Активні замовлення для комплектації та відправки</p>
        </div>

        <div class="fulfillment-board processing-board">
            <div class="fulfillment-column">
                <div class="fulfillment-column__header">
                    <h2>Нові та упаковка</h2>
                    <span class="badge bg-success">{{ greenOrders|length }}</span>
                </div>
                <div class="fulfillment-column__list">
                    {% for order in greenOrders %}
                        {% include 'admin2/fulfillment/_customer_order_card.html.twig' with {
                            order: order,
                            statusFormRoute: statusFormRoute,
                            showStatusSelect: false,
                        } %}
                    {% else %}
                        <div class="fulfillment-empty">Немає замовлень</div>
                    {% endfor %}
                </div>
            </div>

            <div class="fulfillment-column">
                <div class="fulfillment-column__header">
                    <h2>В обробці</h2>
                    <span class="badge bg-secondary">{{ otherOrders|length }}</span>
                </div>
                <div class="fulfillment-column__list">
                    {% for order in otherOrders %}
                        {% include 'admin2/fulfillment/_customer_order_card.html.twig' with {
                            order: order,
                            statusFormRoute: statusFormRoute,
                            showStatusSelect: false,
                        } %}
                    {% else %}
                        <div class="fulfillment-empty">Немає замовлень</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin2-fulfillment.js') }}" defer></script>
    <script src="{{ asset('js/admin2-order-copy.js') }}" defer></script>
{% endblock %}
