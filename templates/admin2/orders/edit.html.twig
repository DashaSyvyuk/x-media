{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/orders/_macros.html.twig' as order_macros %}

{% block title %}{{ isNew|default(false) ? 'Нове замовлення' : 'Замовлення #' ~ order.orderNumber }} — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/product-edit.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/product-picker.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/orders.css') }}">
{% endblock %}

{% block body %}
    <div class="order-edit-page">
        <div class="order-edit-hero">
            <div>
                <a href="{{ path('admin2_orders') }}" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                    <i class="bi bi-arrow-left"></i> До списку замовлень
                </a>
                <h1 class="page-title mb-1">
                    {% if isNew|default(false) %}
                        Нове замовлення
                    {% else %}
                        Замовлення #{{ order.orderNumber }}
                    {% endif %}
                </h1>
                {% if not isNew|default(false) %}
                    <div class="order-edit-hero__meta">
                        {{ order_macros.order_status_badge(order.status) }}
                        <span class="text-muted">· {{ order.createdAt|date('d.m.Y H:i') }}</span>
                    </div>
                {% endif %}
            </div>
            {% if not isNew|default(false) %}
                <div class="order-edit-hero__actions d-flex align-items-center gap-2">
                    {{ order_macros.copy_button(copyText|default(null)) }}
                    {{ order_macros.receipt_button('local', order.id) }}
                    {{ order_macros.invoice_button(order.id) }}
                    <div class="order-edit-hero__total">
                        <div class="order-edit-hero__total-label">Сума</div>
                        <div class="order-edit-hero__total-value">{{ order_macros.money(order.total) }}</div>
                    </div>
                </div>
            {% endif %}
        </div>

        {% if form.vars.errors|length > 0 %}
            <div class="alert alert-danger">{{ form_errors(form) }}</div>
        {% endif %}

        {{ form_start(form, { attr: { class: 'product-edit-form' } }) }}

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card product-edit-section shadow-sm">
                    <div class="card-header">Контактна інформація</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">{{ form_row(form.orderNumber) }}</div>
                            <div class="col-md-4">{{ form_row(form.status) }}</div>
                            <div class="col-md-4">{{ form_row(form.ttn) }}</div>
                            <div class="col-md-4">{{ form_row(form.name) }}</div>
                            <div class="col-md-4">{{ form_row(form.surname) }}</div>
                            <div class="col-md-4">{{ form_row(form.phone) }}</div>
                            <div class="col-md-6">{{ form_row(form.email) }}</div>
                            <div class="col-12">{{ form_row(form.comment) }}</div>
                        </div>
                    </div>
                </div>

                <div class="card product-edit-section shadow-sm">
                    <div class="card-header">Доставка та оплата</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">{{ form_row(form.address) }}</div>
                            <div class="col-md-6">{{ form_row(form.paytype) }}</div>
                            <div class="col-md-6">{{ form_row(form.deltype) }}</div>
                            {% if not isNew|default(false) and order.novaPoshtaCity %}
                                <div class="col-md-6">
                                    <label class="form-label">Місто (Нова Пошта)</label>
                                    <input type="text" class="form-control" value="{{ order.novaPoshtaCity.title }}" disabled>
                                </div>
                            {% endif %}
                            {% if not isNew|default(false) and order.novaPoshtaOffice %}
                                <div class="col-md-6">
                                    <label class="form-label">Відділення (Нова Пошта)</label>
                                    <input type="text" class="form-control" value="{{ order.novaPoshtaOffice.title }}" disabled>
                                </div>
                            {% endif %}
                            <div class="col-md-6">{{ form_row(form.paymentStatus) }}</div>
                            <div class="col-md-6">{{ form_row(form.sendNotification) }}</div>
                        </div>
                    </div>
                </div>

                <div class="card product-edit-section shadow-sm">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Товари</span>
                        <button type="button" class="btn btn-sm btn-outline-teal" id="addOrderItem">
                            <i class="bi bi-plus-lg"></i> Додати
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="orderItems" data-prototype="{{ form_widget(form.items.vars.prototype)|e('html_attr') }}" data-index="{{ form.items|length }}">
                            {% for itemForm in form.items %}
                                <div class="order-item-entry">
                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-6">{{ form_widget(itemForm.product) }}{{ form_errors(itemForm.product) }}</div>
                                        <div class="col-md-3">{{ form_row(itemForm.count) }}</div>
                                        <div class="col-md-2">{{ form_row(itemForm.price) }}</div>
                                        <div class="col-md-1">
                                            <button type="button" class="btn btn-outline-danger btn-sm w-100 remove-order-item" title="Видалити">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card product-edit-section shadow-sm">
                    <div class="card-header">Мітки</div>
                    <div class="card-body">{{ form_row(form.labels) }}</div>
                </div>

                {% if not isNew|default(false) %}
                    <div class="card product-edit-section shadow-sm">
                        <div class="card-header">Деталі</div>
                        <div class="card-body small">
                            <dl class="order-details-list mb-0">
                                <dt>Джерело</dt><dd>{{ order.source ?: '—' }}</dd>
                                <dt>Оновлено</dt><dd>{{ order.updatedAt|date('d.m.Y H:i') }}</dd>
                                {% if order.user %}
                                    <dt>Користувач</dt>
                                    <dd><a href="{{ path('admin2_users_edit', {id: order.user.id}) }}">#{{ order.user.id }}</a></dd>
                                {% endif %}
                            </dl>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {{ form_widget(form.source) }}
        {% do form.items.setRendered() %}

        <div class="product-edit-actions">
            <div class="card border-0 px-3 py-2 product-edit-actions__bar">
                <button type="submit" class="btn btn-teal"><i class="bi bi-check2"></i> Зберегти</button>
                <a href="{{ path('admin2_orders') }}" class="btn btn-outline-secondary">Скасувати</a>
            </div>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin2-product-picker.js') }}" defer></script>
    <script>
        const itemsContainer = document.getElementById('orderItems');
        const addButton = document.getElementById('addOrderItem');

        if (itemsContainer && addButton) {
            addButton.addEventListener('click', () => {
                const prototype = itemsContainer.dataset.prototype;
                const index = parseInt(itemsContainer.dataset.index || '0', 10);
                const html = prototype.replace(/__name__/g, index);
                const wrapper = document.createElement('div');
                wrapper.className = 'order-item-entry';
                wrapper.innerHTML = `<div class="row g-3 align-items-end">${html}<div class="col-md-1"><button type="button" class="btn btn-outline-danger btn-sm w-100 remove-order-item" title="Видалити"><i class="bi bi-trash"></i></button></div></div>`;
                itemsContainer.appendChild(wrapper);
                itemsContainer.dataset.index = String(index + 1);
                window.Admin2ProductPicker?.init(wrapper);
            });

            itemsContainer.addEventListener('click', (event) => {
                const btn = event.target.closest('.remove-order-item');
                if (btn) {
                    btn.closest('.order-item-entry')?.remove();
                }
            });
        }
    </script>
    <script src="{{ asset('js/admin2-order-copy.js') }}" defer></script>
{% endblock %}
