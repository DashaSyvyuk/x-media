{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}Статистика · Фінанси — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/debtors.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/statistics.css') }}">
{% endblock %}

{% block body %}
    <div class="stats-page stats-page--finance"
         data-finance='{{ {
             dailyTurnover: stats.dailyTurnover,
             circulations: {
                 chart: stats.circulations.chart,
                 owedToYouByCurrency: stats.circulations.owedToYouByCurrency,
                 youOweByCurrency: stats.circulations.youOweByCurrency
             },
             debtors: stats.debtors ? {
                 chart: stats.debtors.chart,
                 owedToYouByCurrency: stats.debtors.owedToYouByCurrency,
                 youOweByCurrency: stats.debtors.youOweByCurrency
             } : null
         }|json_encode|e('html_attr') }}'>
        <div class="mb-4">
            <div class="mb-3">
                <h1 class="page-title mb-1">Фінанси</h1>
                <p class="text-muted mb-0 small">
                    {{ stats.from|date('d.m.Y') }} — {{ stats.to|date('d.m.Y') }} · {{ stats.periodLabel }}
                </p>
            </div>

            <div class="stats-filters">
                <div class="stats-period-switch" role="group" aria-label="Період">
                    {% for value, label in periods %}
                        <a href="{{ path('admin2_statistics_finance', {period: value}) }}"
                           class="stats-period-btn {{ stats.period == value ? 'is-active' : '' }}">
                            {{ label }}
                        </a>
                    {% endfor %}
                </div>

                <form method="get" action="{{ path('admin2_statistics_finance') }}" class="stats-date-range" aria-label="Довільний період">
                    <div class="stats-date-fields">
                        <label class="stats-date-field" for="statsFinanceFrom">
                            <span class="stats-date-label">Від</span>
                            <input type="date"
                                   id="statsFinanceFrom"
                                   name="from"
                                   class="form-control stats-date-input"
                                   value="{{ stats.from|date('Y-m-d') }}"
                                   required>
                        </label>
                        <label class="stats-date-field" for="statsFinanceTo">
                            <span class="stats-date-label">До</span>
                            <input type="date"
                                   id="statsFinanceTo"
                                   name="to"
                                   class="form-control stats-date-input"
                                   value="{{ stats.to|date('Y-m-d') }}"
                                   required>
                        </label>
                    </div>
                    <button type="submit" class="btn btn-teal stats-date-submit {{ stats.period == 'custom' ? 'is-active' : '' }}">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        Показати
                    </button>
                </form>
            </div>
        </div>

        <div class="stats-finance-section mb-4">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
                <div>
                    <h2 class="stats-chart-title mb-0">Обіг по касах</h2>
                    <p class="text-muted small mb-0">Прихід і видаток за обраний період</p>
                </div>
                <a href="{{ path('admin2_circulations') }}" class="stats-finance-link">Обіг →</a>
            </div>

            {% if stats.dailyTurnover.totals %}
                <div class="debt-stat-grid debt-stat-grid--compact mb-3" style="grid-template-columns: repeat({{ min(stats.dailyTurnover.totals|length, 3) }}, minmax(0, 1fr));">
                    {% for total in stats.dailyTurnover.totals %}
                        <div class="card debt-stat-card">
                            <div class="debt-stat-card__body">
                                <div class="debt-stat-card__label">Обіг · {{ total.code }}</div>
                                <div class="debt-stat-card__value">{{ total.turnover|number_format(0, '.', ' ') }}</div>
                                <div class="debt-stat-card__hint text-muted small mt-1">
                                    <span class="text-success">+{{ total.income|number_format(0, '.', ' ') }}</span>
                                    ·
                                    <span class="text-danger">−{{ total.expense|number_format(0, '.', ' ') }}</span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="card stats-chart-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <div>
                            <h3 class="stats-chart-title mb-0">Динаміка обігу</h3>
                            <p class="text-muted small mb-0">Операції по касах за день</p>
                        </div>
                    </div>
                    <div class="stats-chart-wrap stats-chart-wrap--tall">
                        <canvas id="statsCirculationDailyChart" aria-label="Обіг по касах за день"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="stats-finance-section mb-4">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
                <div>
                    <h2 class="stats-chart-title mb-0">Активні каси</h2>
                    <p class="text-muted small mb-0">Поточний стан активних кас</p>
                </div>
            </div>
            <div class="debt-stat-grid debt-stat-grid--2 debt-stat-grid--compact">
                <div class="card debt-stat-card">
                    <div class="debt-stat-card__body">
                        <div class="debt-stat-card__label">Кас</div>
                        <div class="debt-stat-card__value">{{ stats.circulations.accounts|number_format(0, '.', ' ') }}</div>
                    </div>
                </div>
                <div class="card debt-stat-card debt-stat-card--positive">
                    <div class="debt-stat-card__body">
                        <div class="debt-stat-card__label">Сума кас</div>
                        {% if stats.circulations.balanceByCurrency %}
                            <div class="debt-stat-card__values">
                                {% for item in stats.circulations.balanceByCurrency %}
                                    <div class="debt-stat-card__value-line">{{ item.total|number_format(0, '.', ' ') }} {{ item.code }}</div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="debt-stat-card__value debt-stat-card__value--empty">—</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-xl-7">
                    <div class="card stats-chart-card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <h3 class="stats-chart-title mb-1">Баланси кас</h3>
                            <p class="text-muted small mb-3">Активні каси за сумою балансу</p>
                            <div class="stats-chart-wrap stats-chart-wrap--finance">
                                <canvas id="statsCirculationBalancesChart" aria-label="Баланси кас"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-5">
                    <div class="card stats-chart-card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <h3 class="stats-chart-title mb-1">Частка кас</h3>
                            <p class="text-muted small mb-3">Розподіл коштів між активними касами</p>
                            <div class="stats-chart-wrap stats-chart-wrap--finance">
                                <canvas id="statsCirculationShareChart" aria-label="Частка кас"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if is_granted('ROLE_SUPER_ADMIN') and stats.debtors %}
            <div class="stats-finance-section">
                <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
                    <div>
                        <h2 class="stats-chart-title mb-0">Активні борги</h2>
                        <p class="text-muted small mb-0">Позитивний баланс — вам винні, негативний — ви винні</p>
                    </div>
                    <a href="{{ path('admin2_debtors') }}" class="stats-finance-link">Борги →</a>
                </div>
                <div class="debt-stat-grid">
                    <div class="card debt-stat-card">
                        <div class="debt-stat-card__body">
                            <div class="debt-stat-card__label">Контактів</div>
                            <div class="debt-stat-card__value">{{ stats.debtors.contacts|number_format(0, '.', ' ') }}</div>
                        </div>
                    </div>
                    <div class="card debt-stat-card debt-stat-card--positive">
                        <div class="debt-stat-card__body">
                            <div class="debt-stat-card__label">Вам винні</div>
                            {% if stats.debtors.owedToYouByCurrency %}
                                <div class="debt-stat-card__values">
                                    {% for item in stats.debtors.owedToYouByCurrency %}
                                        <div class="debt-stat-card__value-line">+{{ item.total|number_format(0, '.', ' ') }} {{ item.code }}</div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="debt-stat-card__value debt-stat-card__value--empty">—</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card debt-stat-card debt-stat-card--negative">
                        <div class="debt-stat-card__body">
                            <div class="debt-stat-card__label">Ви винні</div>
                            {% if stats.debtors.youOweByCurrency %}
                                <div class="debt-stat-card__values">
                                    {% for item in stats.debtors.youOweByCurrency %}
                                        <div class="debt-stat-card__value-line">{{ item.total|number_format(0, '.', ' ') }} {{ item.code }}</div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="debt-stat-card__value debt-stat-card__value--empty">—</div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-xl-8">
                        <div class="card stats-chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="stats-chart-title mb-1">Баланси контактів</h3>
                                <p class="text-muted small mb-3">Активні борги за сумою балансу</p>
                                <div class="stats-chart-wrap stats-chart-wrap--finance">
                                    <canvas id="statsDebtorBalancesChart" aria-label="Баланси боргів"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="card stats-chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="stats-chart-title mb-1">Борги по валютах</h3>
                                <p class="text-muted small mb-3">Скільки вам винні і скільки винні ви</p>
                                <div class="stats-chart-wrap stats-chart-wrap--finance">
                                    <canvas id="statsDebtorStructureChart" aria-label="Борги по валютах"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="{{ asset('js/admin2-statistics-finance.js') }}" defer></script>
{% endblock %}
