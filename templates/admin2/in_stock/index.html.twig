{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/in_stock/_macros.html.twig' as stock_macros %}

{% block title %}Наявність — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
{% endblock %}

{% block body %}
    {% set query = {
        q: search,
        warehouse: warehouseId,
        sort: sort,
        dir: direction,
        perPage: perPage,
    } %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Наявність</h1>
            <p class="text-muted mb-0 small">Залишки товарів на складах</p>
        </div>
        <a href="{{ path('admin2_in_stock_new') }}" class="btn btn-teal">
            <i class="bi bi-plus-lg"></i> Новий запис
        </a>
    </div>

    <div class="card border-0 shadow-sm products-table-card">
        <div class="card-body p-3 p-md-4 border-bottom">
            <form method="get" action="{{ path('admin2_in_stock') }}" class="products-toolbar">
                <div class="products-toolbar__search">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="search" name="q" value="{{ search }}" class="form-control border-start-0" placeholder="ID товару, назва, код, склад">
                    </div>
                </div>
                <select name="warehouse" class="form-select" style="width: auto; min-width: 180px;">
                    <option value="">Усі склади</option>
                    {% for warehouse in warehouses %}
                        <option value="{{ warehouse.id }}" {{ warehouseId == warehouse.id ? 'selected' : '' }}>{{ stock_macros.warehouse_label(warehouse) }}</option>
                    {% endfor %}
                </select>
                <select name="perPage" class="form-select" style="width: auto; min-width: 110px;">
                    {% for option in perPageOptions %}
                        <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }} / стор.</option>
                    {% endfor %}
                </select>
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ direction }}">
                <button type="submit" class="btn btn-teal">Знайти</button>
                {% if search or warehouseId %}
                    <a href="{{ path('admin2_in_stock') }}" class="btn btn-outline-secondary">Скинути</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive">
            <table class="table products-table products-table--mobile-cards align-middle">
                <thead>
                    <tr>
                        <th>{{ stock_macros.sort_link('ID', 'id', sort, direction, query) }}</th>
                        <th>{{ stock_macros.sort_link('Товар', 'product', sort, direction, query) }}</th>
                        <th>{{ stock_macros.sort_link('Склад', 'warehouse', sort, direction, query) }}</th>
                        <th>{{ stock_macros.sort_link('Кількість', 'quantity', sort, direction, query) }}</th>
                        <th>{{ stock_macros.sort_link('Закупівля', 'price', sort, direction, query) }}</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    {% for stock in pagination %}
                        <tr>
                            <td data-label="ID" class="text-muted">#{{ stock.id }}</td>
                            <td data-label="Товар">
                                <div class="product-title">{{ stock.product.title }}</div>
                                <div class="product-title__meta">#{{ stock.product.id }}{% if stock.product.productCode %} · {{ stock.product.productCode }}{% endif %}</div>
                            </td>
                            <td data-label="Склад" class="small">{{ stock_macros.warehouse_label(stock.warehouse) }}</td>
                            <td data-label="Кількість" class="fw-semibold">{{ stock.quantity }}</td>
                            <td data-label="Закупівля">
                                {% if stock.purchasePrice is not null %}
                                    {{ stock.purchasePrice|number_format(0, '.', ' ') }} ₴
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-end col-actions" data-label="">
                                <div class="table-actions">
                                    <a href="{{ path('admin2_in_stock_edit', {id: stock.id}) }}" class="table-action table-action--teal" title="Редагувати">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin2_in_stock_delete', {id: stock.id}) ~ (app.request.queryString ? '?' ~ app.request.queryString : '') }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_in_stock_action') }}">
                                        <button type="submit" class="table-action table-action--danger" title="Видалити" data-confirm="Видалити запис #{{ stock.id }}?">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-5">Записів наявності не знайдено</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.getTotalItemCount() > 0 %}
            <div class="products-footer">
                <div class="products-summary">
                    Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                    з {{ pagination.getTotalItemCount() }}
                </div>
                {% if pagination.pageCount > 1 %}
                    {% set currentPage = pagination.currentPageNumber %}
                    {% set pageCount = pagination.pageCount %}
                    {% set startPage = max(1, currentPage - 2) %}
                    {% set endPage = min(pageCount, currentPage + 2) %}
                    <ul class="products-pagination">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_in_stock', query|merge({page: currentPage - 1})) }}"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        {% if startPage > 1 %}{{ stock_macros.page_link(pagination, 1, query) }}{% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}{% endif %}
                        {% for page in startPage..endPage %}{{ stock_macros.page_link(pagination, page, query) }}{% endfor %}
                        {% if endPage < pageCount %}{% if endPage < pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}{{ stock_macros.page_link(pagination, pageCount, query) }}{% endif %}
                        <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_in_stock', query|merge({page: currentPage + 1})) }}"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.closest('form')?.addEventListener('submit', (event) => {
                if (!window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
{% endblock %}
