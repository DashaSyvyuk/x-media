{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/orders/_macros.html.twig' as order_macros %}

{% set isGod = is_granted('ROLE_SUPER_ADMIN') %}
{% set isStaff = is_granted('ROLE_ADMIN') %}

{% block title %}Головна — X-media Admin{% endblock %}

{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/admin2/dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/planning.css') }}">
{% endblock %}

{% block body %}
    <div class="dashboard-page">
        <section class="dashboard-hero dash-reveal">
            <div class="dashboard-hero__copy">
                <p class="dashboard-hero__brand">X-media</p>
                <h1 class="dashboard-hero__title">Вітаємо, {{ user.name }}</h1>
                <p class="dashboard-hero__subtitle">Сьогодні {{ 'now'|date('d.m.Y') }} · панель магазину</p>
            </div>
            <div class="dashboard-hero__actions">
                {% if isStaff %}
                    <a href="{{ path('admin2_fulfillment') }}" class="dashboard-hero__btn dashboard-hero__btn--primary">
                        <i class="bi bi-kanban"></i> Замовлення
                    </a>
                {% else %}
                    <a href="{{ path('admin2_orders_processing') }}" class="dashboard-hero__btn dashboard-hero__btn--primary">
                        <i class="bi bi-clipboard-check"></i> Обробка замовлень
                    </a>
                {% endif %}
                <a href="{{ path('admin2_products') }}" class="dashboard-hero__btn">
                    <i class="bi bi-box-seam"></i> Товари
                </a>
                <a href="{{ path('admin2_planning') }}" class="dashboard-hero__btn">
                    <i class="bi bi-calendar-check"></i> Планування
                </a>
            </div>
        </section>

        <section class="dashboard-panel dash-reveal dash-reveal--2">
            <div class="dashboard-panel__head">
                <div>
                    <h2 class="dashboard-panel__title">Плани на сьогодні</h2>
                    <p class="dashboard-panel__desc">
                        {% if dash.todayPlans %}
                            Активні завдання · {{ dash.todayPlans|length }}
                        {% else %}
                            Активних завдань немає
                        {% endif %}
                    </p>
                </div>
                <a href="{{ path('admin2_planning') }}" class="dashboard-section-link">Усі →</a>
            </div>
            {% if dash.todayPlans %}
                <div class="dashboard-plan-list">
                    {% for plan in dash.todayPlans %}
                        <a href="{{ path('admin2_planning') }}" class="dashboard-plan-item">
                            <span>
                                <span class="dashboard-plan-item__title">{{ plan.title }}</span>
                                <span class="dashboard-plan-item__meta">{{ plan.assignee }}{% if plan.body %} · {{ plan.body|striptags|slice(0, 80) }}{% if plan.body|length > 80 %}…{% endif %}{% endif %}</span>
                            </span>
                            <span class="dashboard-plan-item__badge">Сьогодні</span>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-muted mb-0 small">На сьогодні активних планів немає.</p>
            {% endif %}
        </section>

        {% if not isStaff %}
            <section class="dashboard-panel dash-reveal dash-reveal--2">
                <div class="dashboard-panel__head">
                    <div>
                        <h2 class="dashboard-panel__title">Упакувати</h2>
                        <p class="dashboard-panel__desc">
                            {% if packingOrders %}
                                Готові до відправлення · {{ packingOrders|length }}
                            {% else %}
                                Замовлень на упаковку немає
                            {% endif %}
                        </p>
                    </div>
                    <a href="{{ path('admin2_orders_processing') }}" class="dashboard-section-link">Обробка →</a>
                </div>
                {% if packingOrders %}
                    <div class="dashboard-pack-list">
                        {% for order in packingOrders %}
                            <a href="{{ path('admin2_orders_processing') }}" class="dashboard-pack-item">
                                <span>
                                    <span class="dashboard-pack-item__title">{{ order.label }}</span>
                                    <span class="dashboard-pack-item__meta">
                                        {{ order.recipient|default(order.customer|default('—')) }}
                                        {% if order.phone|default('') %} · {{ order.phone }}{% endif %}
                                    </span>
                                </span>
                                <span class="dashboard-pack-item__side">
                                    <span class="dashboard-pack-item__status">{{ order.status }}</span>
                                    {% if order.total is defined and order.total %}
                                        <span class="dashboard-pack-item__sum">{{ order.total|number_format(0, '.', ' ') }} ₴</span>
                                    {% endif %}
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted mb-0 small">Немає замовлень зі статусом «Готується до відправлення».</p>
                {% endif %}
            </section>
        {% endif %}

        <section class="dashboard-panel dash-reveal dash-reveal--3">
            <div class="dashboard-panel__head">
                <h2 class="dashboard-panel__title">Курси валют</h2>
                {% if dash.exchangeRates.updated_at %}
                    <span class="dashboard-meta">NBP · {{ dash.exchangeRates.updated_at|date('d.m.Y') }}</span>
                {% endif %}
            </div>
            {% if dash.exchangeRates.error %}
                <div class="alert alert-warning py-2 mb-0">{{ dash.exchangeRates.error }}</div>
            {% else %}
                <div class="exchange-rates-grid">
                    {% for pair in dash.exchangeRates.pairs %}
                        <div class="exchange-rate-item">
                            <div class="exchange-rate-label">{{ pair.label }}</div>
                            <div class="exchange-rate-value">
                                <span class="exchange-rate-pair">1 {{ pair.from }}</span>
                                <strong>{{ pair.value is null ? '—' : pair.value|number_format(pair.value >= 1 ? 2 : 4, '.', ' ') }}</strong>
                                <span class="exchange-rate-pair">{{ pair.to }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        {% if isStaff %}
            <section class="dashboard-kpi-band dash-reveal dash-reveal--3">
                <div class="dashboard-kpi-block">
                    <div class="dashboard-kpi-block__head">
                        <h2 class="dashboard-panel__title">Сьогодні</h2>
                        <span class="dashboard-meta">{{ 'now'|date('d.m.Y') }}</span>
                    </div>
                    <div class="dashboard-kpi-grid">
                        <div class="dashboard-kpi">
                            <div class="dashboard-kpi__label">Замовлень</div>
                            <div class="dashboard-kpi__value">{{ dash.today.orders|number_format(0, '.', ' ') }}</div>
                        </div>
                        <div class="dashboard-kpi">
                            <div class="dashboard-kpi__label">Виручка</div>
                            <div class="dashboard-kpi__value">{{ dash.today.revenue|number_format(0, '.', ' ') }} <span class="dashboard-kpi__unit">₴</span></div>
                        </div>
                        <div class="dashboard-kpi">
                            <div class="dashboard-kpi__label">Оплачено</div>
                            <div class="dashboard-kpi__value">{{ dash.today.paid|number_format(0, '.', ' ') }}</div>
                        </div>
                    </div>
                </div>
                <div class="dashboard-kpi-block">
                    <div class="dashboard-kpi-block__head">
                        <h2 class="dashboard-panel__title">З початку місяця</h2>
                        <span class="dashboard-meta">{{ dash.monthLabel }}</span>
                    </div>
                    <div class="dashboard-kpi-grid dashboard-kpi-grid--4">
                        <div class="dashboard-kpi">
                            <div class="dashboard-kpi__label">Замовлень</div>
                            <div class="dashboard-kpi__value">{{ dash.month.orders|number_format(0, '.', ' ') }}</div>
                        </div>
                        <div class="dashboard-kpi">
                            <div class="dashboard-kpi__label">Виручка</div>
                            <div class="dashboard-kpi__value">{{ dash.month.revenue|number_format(0, '.', ' ') }} <span class="dashboard-kpi__unit">₴</span></div>
                        </div>
                        <div class="dashboard-kpi">
                            <div class="dashboard-kpi__label">Оплачено</div>
                            <div class="dashboard-kpi__value">{{ dash.month.paid|number_format(0, '.', ' ') }}</div>
                        </div>
                        <div class="dashboard-kpi">
                            <div class="dashboard-kpi__label">Скасування</div>
                            <div class="dashboard-kpi__value">{{ dash.month.cancelRate }}<span class="dashboard-kpi__unit">%</span></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="dashboard-panel dash-reveal dash-reveal--4">
                <div class="dashboard-panel__head">
                    <div>
                        <h2 class="dashboard-panel__title">Обіг за сьогодні</h2>
                        <p class="dashboard-panel__desc">Рух по касах · {{ 'now'|date('d.m.Y') }}</p>
                    </div>
                    <a href="{{ path('admin2_circulations') }}" class="dashboard-section-link">Обіг →</a>
                </div>

                <div class="dashboard-cash-grid">
                    <div class="dashboard-cash dashboard-cash--in">
                        <div class="dashboard-kpi__label">Надходження</div>
                        {% if dash.circulationToday.incomeByCurrency %}
                            {% for item in dash.circulationToday.incomeByCurrency %}
                                <div class="dashboard-kpi__value-line">+{{ item.total|number_format(0, '.', ' ') }} {{ item.code }}</div>
                            {% endfor %}
                        {% else %}
                            <div class="dashboard-kpi__value dashboard-kpi__value--muted">—</div>
                        {% endif %}
                    </div>
                    <div class="dashboard-cash dashboard-cash--out">
                        <div class="dashboard-kpi__label">Видатки</div>
                        {% if dash.circulationToday.expenseByCurrency %}
                            {% for item in dash.circulationToday.expenseByCurrency %}
                                <div class="dashboard-kpi__value-line">{{ item.total|number_format(0, '.', ' ') }} {{ item.code }}</div>
                            {% endfor %}
                        {% else %}
                            <div class="dashboard-kpi__value dashboard-kpi__value--muted">—</div>
                        {% endif %}
                    </div>
                    <div class="dashboard-cash">
                        <div class="dashboard-kpi__label">Сальдо</div>
                        {% if dash.circulationToday.netByCurrency %}
                            {% for item in dash.circulationToday.netByCurrency %}
                                <div class="dashboard-kpi__value-line {{ item.total >= 0 ? 'is-positive' : 'is-negative' }}">
                                    {{ item.total > 0 ? '+' : '' }}{{ item.total|number_format(0, '.', ' ') }} {{ item.code }}
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="dashboard-kpi__value dashboard-kpi__value--muted">—</div>
                        {% endif %}
                    </div>
                </div>

                {% if dash.circulationToday.payments %}
                    <div class="dashboard-payment-list">
                        {% for payment in dash.circulationToday.payments %}
                            <div class="dashboard-payment-row">
                                <span class="dashboard-meta dashboard-payment-row__time">{{ payment.createdAt|date('H:i') }}</span>
                                <span class="dashboard-payment-row__cash">{{ payment.cash }}</span>
                                <span class="dashboard-payment-row__desc">{{ payment.description ?: payment.note ?: '—' }}</span>
                                <span class="dashboard-order-sum {{ payment.sum >= 0 ? 'is-positive' : 'is-negative' }}">
                                    {{ payment.sum > 0 ? '+' : '' }}{{ payment.sum|number_format(0, '.', ' ') }} {{ payment.code }}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="dashboard-empty mb-0">Сьогодні рухів по касах ще не було.</p>
                {% endif %}
            </section>

            <div class="dashboard-main-grid dash-reveal dash-reveal--5">
                <section class="dashboard-panel">
                    <div class="dashboard-panel__head">
                        <div>
                            <h2 class="dashboard-panel__title">Актуальні замовлення</h2>
                            <p class="dashboard-panel__desc">Нові та в роботі</p>
                        </div>
                        <a href="{{ path('admin2_orders') }}" class="dashboard-section-link">Усі →</a>
                    </div>

                    {% if dash.activeOrders %}
                        <div class="dashboard-order-list">
                            {% for order in dash.activeOrders %}
                                {% set orderUrl = order.isRozetka|default(false)
                                    ? path('admin2_rozetka_orders_show', {id: order.id})
                                    : path('admin2_orders_edit', {id: order.id}) %}
                                <div class="dashboard-order-row">
                                    <div class="dashboard-order-row__main">
                                        <div class="dashboard-order-row__id">
                                            <span class="dashboard-order-num">
                                                {{ order.orderNumber ?: ('#' ~ order.id) }}
                                                {% if order.isRozetka|default(false) %}
                                                    <span class="dashboard-order-source">RZ</span>
                                                {% endif %}
                                            </span>
                                            <span class="dashboard-meta">{{ order.createdAt|date('d.m H:i') }}</span>
                                        </div>
                                        <div class="dashboard-order-row__customer">
                                            <span class="dashboard-order-customer">{{ order.customer ?: '—' }}</span>
                                            {% if order.phone %}
                                                <span class="dashboard-meta">{{ order.phone }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="dashboard-order-row__side">
                                        <span class="order-status-badge" style="--status-color: {{ order.statusColor|default('#64748b') }}">
                                            {{ order.statusLabel|default(order.status) }}
                                        </span>
                                        {{ order_macros.payment_status_badge(order.paymentStatus|default(false)) }}
                                        <span class="dashboard-order-sum">{{ order.total|number_format(0, '.', ' ') }} ₴</span>
                                        <a href="{{ orderUrl }}" class="dashboard-open-btn" title="Відкрити">
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="dashboard-empty mb-0">Актуальних замовлень немає.</p>
                    {% endif %}
                </section>

                <div class="dashboard-side-stack">
                    <section class="dashboard-panel dashboard-panel--fops">
                        <div class="dashboard-panel__head">
                            <h2 class="dashboard-panel__title">ФОПи</h2>
                            <a href="{{ path('admin2_settings', {tab: 'fops'}) }}" class="dashboard-section-link">Усі →</a>
                        </div>

                        {% if dash.fops %}
                            <div class="dashboard-fop-list">
                                {% for fop in dash.fops %}
                                    <div class="dashboard-fop-item">
                                        <span class="dashboard-fop-item__title">{{ fop.title }}</span>
                                        {{ order_macros.copy_button(fop.title, 'Скопіювати назву') }}
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="dashboard-empty mb-0">ФОПів поки немає.</p>
                        {% endif %}
                    </section>

                    {% if isGod %}
                        <section class="dashboard-panel dashboard-panel--debts">
                            <div class="dashboard-panel__head">
                                <div>
                                    <h2 class="dashboard-panel__title">Борги</h2>
                                    <p class="dashboard-panel__desc">Активні контакти</p>
                                </div>
                                <a href="{{ path('admin2_debtors') }}" class="dashboard-section-link">Усі →</a>
                            </div>

                            {% if dash.debts %}
                                <div class="dashboard-debt-list">
                                    {% for debt in dash.debts %}
                                        <a href="{{ path('admin2_debtors_show', {id: debt.id}) }}" class="dashboard-debt-item">
                                            <span class="dashboard-debt-item__name">{{ debt.name }}</span>
                                            <span class="dashboard-debt-item__sum {{ debt.balance >= 0 ? 'is-positive' : 'is-negative' }}">
                                                {{ debt.balance > 0 ? '+' : '' }}{{ debt.balance|number_format(0, '.', ' ') }} {{ debt.code }}
                                            </span>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="dashboard-empty mb-0">Активних боргів немає.</p>
                            {% endif %}
                        </section>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {% if isStaff %}
        <script src="{{ asset('js/admin2-order-copy.js') }}" defer></script>
    {% endif %}
{% endblock %}
