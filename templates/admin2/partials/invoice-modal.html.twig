<div class="modal fade" id="orderInvoiceModal" tabindex="-1" aria-hidden="true" data-csrf-token="{{ csrf_token }}">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Рахунок + видаткова</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="orderInvoiceError"></div>

                <div class="mb-3">
                    <label class="form-label">Наш ФОП</label>
                    <select class="form-select" id="invoiceFopId"></select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Отримувач</label>
                    <input type="text" class="form-control" id="invoiceReceiverName" placeholder="ФОП Омельченко Владислав Ігорович">
                </div>

                <div class="mb-3">
                    <label class="form-label">Реквізити отримувача</label>
                    <textarea class="form-control" id="invoiceReceiverReq" rows="4" placeholder="Код ЄДРПОУ: ...&#10;UA..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                <button type="button" class="btn btn-teal" id="invoiceGenerateBtn">Згенерувати</button>
            </div>
        </div>
    </div>
</div>

