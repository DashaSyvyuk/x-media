{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}{{ isNew|default(false) ? 'Новий feed' : 'Feed #' ~ feed.id }} — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/product-edit.css') }}">
{% endblock %}

{% block body %}
    <div class="product-edit-header">
        <div>
            <a href="{{ path('admin2_feeds') }}" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> До списку feeds
            </a>
            <h1 class="page-title mb-1">{{ isNew|default(false) ? 'Новий feed' : 'Feed #' ~ feed.id }}</h1>
        </div>
    </div>

    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">{{ form_errors(form) }}</div>
    {% endif %}

    {{ form_start(form, { attr: { class: 'product-edit-form' } }) }}
    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Параметри feed</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">{{ form_row(form.type) }}</div>
                <div class="col-md-4">{{ form_row(form.ourPercent) }}</div>
                <div class="col-md-4">{{ form_row(form.fee) }}</div>
                <div class="col-md-6 d-flex align-items-end">{{ form_row(form.cutCharacteristics) }}</div>
                <div class="col-md-6">{{ form_row(form.ignoreBrands) }}</div>
            </div>
        </div>
    </div>
    <div class="product-edit-actions">
        <div class="card border-0 px-3 py-2 product-edit-actions__bar">
            <button type="submit" class="btn btn-teal"><i class="bi bi-check2"></i> Зберегти</button>
            <a href="{{ path('admin2_feeds') }}" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
