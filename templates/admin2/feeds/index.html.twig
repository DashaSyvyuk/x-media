{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/feeds/_macros.html.twig' as feed_macros %}

{% block title %}Feeds — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
{% endblock %}

{% block body %}
    {% set query = { q: search, sort: sort, dir: direction, perPage: perPage } %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Feeds</h1>
            <p class="text-muted mb-0 small">Параметри XML-фідів маркетплейсів</p>
        </div>
        <a href="{{ path('admin2_feeds_new') }}" class="btn btn-teal">
            <i class="bi bi-plus-lg"></i> Новий feed
        </a>
    </div>

    <div class="card border-0 shadow-sm products-table-card">
        <div class="card-body p-3 p-md-4 border-bottom">
            <form method="get" action="{{ path('admin2_feeds') }}" class="products-toolbar">
                <div class="products-toolbar__search">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="search" name="q" value="{{ search }}" class="form-control border-start-0" placeholder="Тип feed">
                    </div>
                </div>
                <select name="perPage" class="form-select" style="width: auto; min-width: 110px;">
                    {% for option in perPageOptions %}
                        <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }} / стор.</option>
                    {% endfor %}
                </select>
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ direction }}">
                <button type="submit" class="btn btn-teal">Знайти</button>
                {% if search %}<a href="{{ path('admin2_feeds') }}" class="btn btn-outline-secondary">Скинути</a>{% endif %}
            </form>
        </div>

        <div class="table-responsive">
            <table class="table products-table align-middle">
                <thead>
                    <tr>
                        <th>{{ feed_macros.sort_link('ID', 'id', sort, direction, query) }}</th>
                        <th>{{ feed_macros.sort_link('Тип', 'type', sort, direction, query) }}</th>
                        <th>Our %</th>
                        <th>Fee</th>
                        <th>Обрізати</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    {% for feed in pagination %}
                        <tr>
                            <td class="text-muted">#{{ feed.id }}</td>
                            <td class="fw-semibold">{{ feed_macros.type_label(feed.type, typeLabels) }}</td>
                            <td>{{ feed.ourPercent }}</td>
                            <td>{{ feed.fee }}</td>
                            <td>{{ feed.cutCharacteristics ? 'Так' : 'Ні' }}</td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a href="{{ path('admin2_feeds_edit', {id: feed.id}) }}" class="table-action table-action--teal" title="Редагувати">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin2_feeds_delete', {id: feed.id}) ~ (app.request.queryString ? '?' ~ app.request.queryString : '') }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_feed_action') }}">
                                        <button type="submit" class="table-action table-action--danger" title="Видалити" data-confirm="Видалити feed #{{ feed.id }}?">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-5">Feeds не знайдено</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.getTotalItemCount() > 0 %}
            <div class="products-footer">
                <div class="products-summary">
                    Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                    з {{ pagination.getTotalItemCount() }}
                </div>
                {% if pagination.pageCount > 1 %}
                    {% set currentPage = pagination.currentPageNumber %}
                    {% set pageCount = pagination.pageCount %}
                    {% set startPage = max(1, currentPage - 2) %}
                    {% set endPage = min(pageCount, currentPage + 2) %}
                    <ul class="products-pagination">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_feeds', query|merge({page: currentPage - 1})) }}"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        {% if startPage > 1 %}{{ feed_macros.page_link(pagination, 1, query) }}{% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}{% endif %}
                        {% for page in startPage..endPage %}{{ feed_macros.page_link(pagination, page, query) }}{% endfor %}
                        {% if endPage < pageCount %}{% if endPage < pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}{{ feed_macros.page_link(pagination, pageCount, query) }}{% endif %}
                        <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_feeds', query|merge({page: currentPage + 1})) }}"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.closest('form')?.addEventListener('submit', (event) => {
                if (!window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
{% endblock %}
