<div class="settings-tab-toolbar">
    <h2 class="h5 mb-0">ФОП (реквізити)</h2>
    <button type="button" class="btn btn-teal btn-sm" data-bs-toggle="modal" data-bs-target="#createFopModal">
        <i class="bi bi-plus-lg"></i> Додати ФОП
    </button>
</div>

<div class="settings-table-scroll">
    <table class="table products-table align-middle mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Назва</th>
                <th>ЄДРПОУ</th>
                <th>Рахунок / Банк</th>
                <th>Адреса</th>
                <th class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
            {% for fop in fops %}
                <tr>
                    <td class="text-muted">#{{ fop.id }}</td>
                    <td class="fw-semibold">{{ fop.title }}</td>
                    <td><code>{{ fop.edrpou }}</code></td>
                    <td class="small">{{ fop.bankAccount }}</td>
                    <td class="small text-muted">{{ fop.address }}</td>
                    <td class="text-end text-nowrap">
                        <button type="button"
                                class="btn btn-sm btn-outline-teal js-edit-fop"
                                data-bs-toggle="modal"
                                data-bs-target="#editFopModal"
                                data-id="{{ fop.id }}"
                                data-title="{{ fop.title|e('html_attr') }}"
                                data-edrpou="{{ fop.edrpou|e('html_attr') }}"
                                data-bank-account="{{ fop.bankAccount|e('html_attr') }}"
                                data-address="{{ fop.address|e('html_attr') }}">
                            Редагувати
                        </button>
                        <form method="post"
                              action="{{ path('admin2_settings_fops_delete', {id: fop.id}) }}"
                              class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin2_settings_fop') }}">
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    data-confirm="Видалити ФОП «{{ fop.title|e('html_attr') }}»?">
                                Видалити
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">ФОП ще немає</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

