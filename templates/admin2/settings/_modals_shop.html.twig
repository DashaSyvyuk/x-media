<div class="modal fade" id="createShopSettingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('admin2_settings_shop_store') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin2_settings_shop') }}">
                <div class="modal-header">
                    <h5 class="modal-title">Новий параметр</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Назва</label>
                        <input type="text" name="shop_setting[title]" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Slug</label>
                        <input type="text" name="shop_setting[slug]" class="form-control" required>
                    </div>
                    <div>
                        <label class="form-label">Значення</label>
                        <textarea name="shop_setting[value]" class="form-control" rows="4"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-teal">Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editShopSettingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="editShopSettingForm" action="">
                <input type="hidden" name="_token" value="{{ csrf_token('admin2_settings_shop') }}">
                <div class="modal-header">
                    <h5 class="modal-title">Редагувати параметр</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Назва</label>
                        <input type="text" name="shop_setting[title]" id="editShopSettingTitle" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Slug</label>
                        <input type="text" name="shop_setting[slug]" id="editShopSettingSlug" class="form-control" readonly>
                    </div>
                    <div>
                        <label class="form-label">Значення</label>
                        <textarea name="shop_setting[value]" id="editShopSettingValue" class="form-control" rows="4"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-teal">Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>
