{% set adminRoles = constant('App\\Entity\\AdminUser::ROLES') %}

<div class="modal fade" id="createAdminUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('admin2_settings_admins_store') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin2_settings_admin') }}">
                <div class="modal-header">
                    <h5 class="modal-title">Новий адмін</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Логін (email)</label>
                        <input type="email" name="admin_user_settings[email]" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Пароль</label>
                        <input type="password" name="admin_user_settings[plainPassword]" class="form-control" required autocomplete="new-password">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Імʼя</label>
                        <input type="text" name="admin_user_settings[name]" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Прізвище</label>
                        <input type="text" name="admin_user_settings[surname]" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Телефон</label>
                        <input type="text" name="admin_user_settings[phone]" class="form-control">
                    </div>
                    <div>
                        <label class="form-label d-block mb-2">Ролі</label>
                        {% for label, role in adminRoles %}
                            <div class="form-check">
                                <input type="checkbox"
                                       name="admin_user_settings[roles][]"
                                       value="{{ role }}"
                                       class="form-check-input"
                                       id="createAdminRole{{ role|replace({'ROLE_': ''}) }}">
                                <label class="form-check-label" for="createAdminRole{{ role|replace({'ROLE_': ''}) }}">{{ label }}</label>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-teal">Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editAdminUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="editAdminUserForm" action="">
                <input type="hidden" name="_token" value="{{ csrf_token('admin2_settings_admin') }}">
                <div class="modal-header">
                    <h5 class="modal-title">Редагувати адміна</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Логін (email)</label>
                        <input type="email" name="admin_user_settings[email]" id="editAdminUserEmail" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Новий пароль</label>
                        <input type="password" name="admin_user_settings[plainPassword]" class="form-control" autocomplete="new-password">
                        <div class="form-text">Залиште порожнім, якщо пароль не змінюється</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Імʼя</label>
                        <input type="text" name="admin_user_settings[name]" id="editAdminUserName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Прізвище</label>
                        <input type="text" name="admin_user_settings[surname]" id="editAdminUserSurname" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Телефон</label>
                        <input type="text" name="admin_user_settings[phone]" id="editAdminUserPhone" class="form-control">
                    </div>
                    <div>
                        <label class="form-label d-block mb-2">Ролі</label>
                        {% for label, role in adminRoles %}
                            <div class="form-check">
                                <input type="checkbox"
                                       name="admin_user_settings[roles][]"
                                       value="{{ role }}"
                                       class="form-check-input js-edit-admin-role"
                                       id="editAdminRole{{ role|replace({'ROLE_': ''}) }}">
                                <label class="form-check-label" for="editAdminRole{{ role|replace({'ROLE_': ''}) }}">{{ label }}</label>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-teal">Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>
