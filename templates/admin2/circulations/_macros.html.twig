{% macro money(value, code) %}
    {% set formatted = value|number_format(0, '.', ' ') %}
    {% if value > 0 %}
        <span class="debt-money debt-money--positive">+{{ formatted }}{% if code %} {{ code }}{% endif %}</span>
    {% elseif value < 0 %}
        <span class="debt-money debt-money--negative">{{ formatted }}{% if code %} {{ code }}{% endif %}</span>
    {% else %}
        <span class="debt-money debt-money--zero">{{ formatted }}{% if code %} {{ code }}{% endif %}</span>
    {% endif %}
{% endmacro %}

{% macro balance_label(value) %}
    {% if value > 0 %}
        На рахунку
    {% elseif value < 0 %}
        В мінусі
    {% else %}
        Баланс нульовий
    {% endif %}
{% endmacro %}

{% macro sort_link(label, field, currentSort, currentDir, query) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    {% set params = query|merge({sort: field, dir: nextDir, page: 1}) %}
    <a href="{{ path('admin2_circulations', params) }}" class="sort-link {{ currentSort == field ? 'active' : '' }}">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-chevron-{{ currentDir == 'ASC' ? 'up' : 'down' }}"></i>
        {% endif %}
    </a>
{% endmacro %}

{% macro page_link(pagination, page, query) %}
    {% set params = query|merge({page: page}) %}
    <li class="page-item {{ page == pagination.currentPageNumber ? 'active' : '' }}">
        <a class="page-link" href="{{ path('admin2_circulations', params) }}">{{ page }}</a>
    </li>
{% endmacro %}
