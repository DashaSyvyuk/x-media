{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/orders/_macros.html.twig' as order_macros %}

{% block title %}Картки — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/cards.css') }}">
{% endblock %}

{% block body %}
<div class="cards-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Картки</h1>
            <p class="text-muted mb-0 small">TaxFree операції по платіжних картках</p>
        </div>
        <a href="{{ path('admin2_cards_all_operations') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-table"></i> Всі операції
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    {% if cards is empty %}
        <div class="text-center text-muted py-5">
            <i class="bi bi-credit-card fs-1 d-block mb-2"></i>
            Картки ще не додані. Додайте їх у <a href="{{ path('admin2_settings', {tab: 'cards'}) }}">Налаштування → Картки</a>.
        </div>
    {% else %}
        <div class="cards-grid">
            {% for card in cards %}
                <div class="card-item">
                    <div class="card-item__header">
                        <div class="card-item__title">{{ card.title }}</div>
                        <div class="card-item__actions">
                            {{ order_macros.copy_button(card.clipboardText, 'Скопіювати реквізити') }}
                            <a href="{{ path('admin2_cards_show', {id: card.id}) }}" class="btn btn-sm btn-outline-teal">
                                <i class="bi bi-list-ul"></i> Деталі
                            </a>
                        </div>
                    </div>
                    <div class="card-item__body">
                        <div class="card-item__number">{{ card.cardNumberFormatted }}</div>
                        <div class="card-item__meta">
                            <span class="card-item__holder">{{ card.holderName }}</span>
                            <span class="card-item__expiry">{{ card.expiry }}</span>
                        </div>
                    </div>
                    <div class="card-item__footer">
                        <button type="button"
                                class="btn btn-teal btn-sm w-100"
                                data-bs-toggle="modal"
                                data-bs-target="#addOpModal"
                                data-card-id="{{ card.id }}"
                                data-card-title="{{ card.title|e('html_attr') }}">
                            <i class="bi bi-plus-lg"></i> Додати операцію
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{# Add operation modal #}
<div class="modal fade" id="addOpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" id="addOpForm" action="">
                <input type="hidden" name="_token" value="{{ csrf_token('admin2_card_op') }}">
                <div class="modal-header">
                    <h5 class="modal-title">Нова операція — <span id="addOpCardTitle"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Сума TaxFree</label>
                        <div class="input-group">
                            <input type="number" name="amount" class="form-control" step="0.01" min="0"
                                   placeholder="0.00" required autofocus>
                            <span class="input-group-text">€</span>
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Нотатка (необов'язково)</label>
                        <input type="text" name="note" class="form-control" placeholder="…">
                    </div>
                    <div class="mt-2 text-muted small">
                        <i class="bi bi-calendar3"></i> Дата: <strong id="addOpDate"></strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-teal">Додати</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('addOpModal');
    modal.addEventListener('show.bs.modal', (e) => {
        const btn    = e.relatedTarget;
        const cardId = btn.dataset.cardId;
        document.getElementById('addOpCardTitle').textContent = btn.dataset.cardTitle;
        document.getElementById('addOpForm').action = `/admin/cards/${cardId}/operations`;
        const now = new Date();
        document.getElementById('addOpDate').textContent = now.toLocaleDateString('uk-UA');
    });
});
</script>
{% endblock %}
