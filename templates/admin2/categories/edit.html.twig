{% extends 'admin2/layouts/base.html.twig' %}

{% import 'admin2/products/_collapsible_collection_item.html.twig' as collapsible %}

{% block title %}{{ isNew|default(false) ? 'Нова категорія' : 'Редагування #' ~ category.id }} — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/product-edit.css') }}">
{% endblock %}

{% block body %}
    <div class="product-edit-header">
        <div>
            <a href="{{ path('admin2_categories') }}" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> До списку категорій
            </a>
            <h1 class="page-title mb-1">{{ category.title ?: (isNew|default(false) ? 'Нова категорія' : 'Категорія #' ~ category.id) }}</h1>
            {% if isNew|default(false) %}
                <div class="product-edit-meta">Заповніть поля та натисніть «Зберегти»</div>
            {% else %}
                <div class="product-edit-meta">ID #{{ category.id }} · /categories/{{ category.slug }}</div>
            {% endif %}
        </div>
        {% if not isNew|default(false) and category.slug %}
            <a href="/categories/{{ category.slug }}" target="_blank" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-arrow-up-right"></i> На сайті
            </a>
        {% endif %}
    </div>

    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">{{ form_errors(form) }}</div>
    {% endif %}

    {{ form_start(form, { attr: { class: 'product-edit-form', enctype: 'multipart/form-data' } }) }}

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Основне</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.title) }}</div>
                <div class="col-md-6">{{ form_row(form.slug) }}</div>
                <div class="col-md-6">{{ form_row(form.parent) }}</div>
                <div class="col-md-3">{{ form_row(form.position) }}</div>
                <div class="col-md-3 d-flex align-items-end">{{ form_row(form.status) }}</div>
                <div class="col-md-6">{{ form_row(form.imageFile) }}</div>
                <div class="col-md-6 d-flex align-items-end">
                    {% if category.imageUri %}
                        <img src="{{ category.imageUri }}" alt="" class="product-image-preview">
                    {% endif %}
                </div>
                <div class="col-md-6 d-flex align-items-end">{{ form_row(form.showInHeader) }}</div>
            </div>
        </div>
    </div>

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">SEO</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">{{ form_row(form.metaKeyword) }}</div>
                <div class="col-12">{{ form_row(form.metaDescription) }}</div>
            </div>
        </div>
    </div>

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Маркетплейси та feeds</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">{{ form_row(form.hotlineCategory) }}</div>
                <div class="col-md-4">{{ form_row(form.rozetkaCategory) }}</div>
                <div class="col-md-4">{{ form_row(form.promCategoryLink) }}</div>
                <div class="col-md-6 col-lg-3 d-flex align-items-end">{{ form_row(form.showInEkatalogFeed) }}</div>
                <div class="col-md-6 col-lg-3 d-flex align-items-end">{{ form_row(form.showInPromFeed) }}</div>
                <div class="col-md-6 col-lg-3 d-flex align-items-end">{{ form_row(form.showInRozetkaFeed) }}</div>
                <div class="col-md-6 col-lg-3 d-flex align-items-end">{{ form_row(form.showInHotlineFeed) }}</div>
            </div>
        </div>
    </div>

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Ціни feeds</div>
        <div class="card-body">
            {% set feedPriceBody %}
            <div class="row g-3">
                <div class="col-md-4">{{ form_row(form.feedPrices.vars.prototype.feed) }}</div>
                <div class="col-md-4">{{ form_row(form.feedPrices.vars.prototype.ourPercent) }}</div>
                <div class="col-md-4">{{ form_row(form.feedPrices.vars.prototype.fee) }}</div>
            </div>
            {% endset %}
            <div id="feed-prices-collection"
                 data-collapsible-type="feed-price"
                 data-prototype="{{ feedPriceBody|e('html_attr') }}">
                {% for feedPriceField in form.feedPrices %}
                    {% set body %}
                    <div class="row g-3">
                        <div class="col-md-4">{{ form_row(feedPriceField.feed) }}</div>
                        <div class="col-md-4">{{ form_row(feedPriceField.ourPercent) }}</div>
                        <div class="col-md-4">{{ form_row(feedPriceField.fee) }}</div>
                    </div>
                    {% endset %}
                    {{ collapsible.item('feed-price', body, true) }}
                {% endfor %}
            </div>
            <button type="button" class="btn btn-outline-teal btn-sm add-collection-row" data-collection-add="#feed-prices-collection">
                <i class="bi bi-plus-lg"></i> Додати feed
            </button>
        </div>
    </div>

    <div class="product-edit-actions">
        <div class="card border-0 px-3 py-2 product-edit-actions__bar">
            <button type="submit" class="btn btn-teal">
                <i class="bi bi-check2"></i> Зберегти
            </button>
            <a href="{{ path('admin2_categories') }}" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin2-collection.js') }}" defer></script>
{% endblock %}
