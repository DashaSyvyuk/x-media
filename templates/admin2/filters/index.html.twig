{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/filters/_macros.html.twig' as filter_macros %}

{% block title %}Фільтри — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
{% endblock %}

{% block body %}
    {% set query = {
        q: search,
        category: categoryId,
        sort: sort,
        dir: direction,
        perPage: perPage,
    } %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Фільтри</h1>
            <p class="text-muted mb-0 small">Параметри фільтрації товарів у категоріях</p>
        </div>
        <a href="{{ path('admin2_filters_new') }}" class="btn btn-teal">
            <i class="bi bi-plus-lg"></i> Новий фільтр
        </a>
    </div>

    <div class="card border-0 shadow-sm products-table-card">
        <div class="card-body p-3 p-md-4 border-bottom">
            <form method="get" action="{{ path('admin2_filters') }}" class="products-toolbar">
                <div class="products-toolbar__search">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="search"
                               name="q"
                               value="{{ search }}"
                               class="form-control border-start-0"
                               placeholder="Назва фільтра або категорія">
                    </div>
                </div>

                <select name="category" class="form-select" style="width: auto; min-width: 180px;">
                    <option value="">Усі категорії</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {{ categoryId == category.id ? 'selected' : '' }}>{{ category.title }}</option>
                    {% endfor %}
                </select>

                <select name="perPage" class="form-select" style="width: auto; min-width: 110px;">
                    {% for option in perPageOptions %}
                        <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }} / стор.</option>
                    {% endfor %}
                </select>

                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ direction }}">

                <button type="submit" class="btn btn-teal">Знайти</button>

                {% if search or categoryId %}
                    <a href="{{ path('admin2_filters') }}" class="btn btn-outline-secondary">Скинути</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive">
            <table class="table products-table align-middle">
                <thead>
                    <tr>
                        <th>{{ filter_macros.sort_link('ID', 'id', sort, direction, query) }}</th>
                        <th>{{ filter_macros.sort_link('Назва', 'title', sort, direction, query) }}</th>
                        <th>{{ filter_macros.sort_link('Категорія', 'category', sort, direction, query) }}</th>
                        <th>{{ filter_macros.sort_link('Пріоритет', 'priority', sort, direction, query) }}</th>
                        <th>{{ filter_macros.sort_link('Відкритих', 'openedCount', sort, direction, query) }}</th>
                        <th>Стан</th>
                        <th style="width: 100px;" class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    {% for filter in pagination %}
                        <tr>
                            <td class="text-muted">#{{ filter.id }}</td>
                            <td>
                                <div class="product-title">{{ filter.title }}</div>
                                <div class="product-title__meta">{{ filter.attributes|length }} параметр(ів)</div>
                            </td>
                            <td class="text-muted small">{{ filter.category ? filter.category.title : '—' }}</td>
                            <td>{{ filter.priority ?? '—' }}</td>
                            <td>{{ filter.openedCount }}</td>
                            <td>
                                {% if filter.isOpened %}
                                    <span class="status-badge status-badge--blocked">Закритий</span>
                                {% else %}
                                    <span class="status-badge status-badge--active">Відкритий</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a href="{{ path('admin2_filters_edit', {id: filter.id}) }}"
                                       class="table-action table-action--teal"
                                       title="Редагувати">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form method="post"
                                          action="{{ path('admin2_filters_delete', {id: filter.id}) ~ (app.request.queryString ? '?' ~ app.request.queryString : '') }}"
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_filter_action') }}">
                                        <button type="submit"
                                                class="table-action table-action--danger"
                                                title="Видалити"
                                                data-confirm="Видалити фільтр «{{ filter.title|e('html_attr') }}»?">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-funnel fs-2 d-block mb-2"></i>
                                Фільтрів не знайдено
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.getTotalItemCount() > 0 %}
            <div class="products-footer">
                <div class="products-summary">
                    Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                    з {{ pagination.getTotalItemCount() }}
                </div>

                {% if pagination.pageCount > 1 %}
                    {% set currentPage = pagination.currentPageNumber %}
                    {% set pageCount = pagination.pageCount %}
                    {% set startPage = max(1, currentPage - 2) %}
                    {% set endPage = min(pageCount, currentPage + 2) %}

                    <ul class="products-pagination">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_filters', query|merge({page: currentPage - 1})) }}">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        {% if startPage > 1 %}
                            {{ filter_macros.page_link(pagination, 1, query) }}
                            {% if startPage > 2 %}
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            {% endif %}
                        {% endif %}

                        {% for page in startPage..endPage %}
                            {{ filter_macros.page_link(pagination, page, query) }}
                        {% endfor %}

                        {% if endPage < pageCount %}
                            {% if endPage < pageCount - 1 %}
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            {% endif %}
                            {{ filter_macros.page_link(pagination, pageCount, query) }}
                        {% endif %}

                        <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_filters', query|merge({page: currentPage + 1})) }}">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.closest('form')?.addEventListener('submit', (event) => {
                if (!window.confirm(button.dataset.confirm)) {
                    event.preventDefault();
                }
            });
        });
    </script>
{% endblock %}
