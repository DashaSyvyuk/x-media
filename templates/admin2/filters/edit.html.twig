{% extends 'admin2/layouts/base.html.twig' %}

{% import 'admin2/products/_collapsible_collection_item.html.twig' as collapsible %}

{% block title %}{{ isNew|default(false) ? 'Новий фільтр' : 'Редагування #' ~ filter.id }} — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/product-edit.css') }}">
{% endblock %}

{% block body %}
    <div class="product-edit-header">
        <div>
            <a href="{{ path('admin2_filters') }}" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> До списку фільтрів
            </a>
            <h1 class="page-title mb-1">{{ filter.title ?: (isNew|default(false) ? 'Новий фільтр' : 'Фільтр #' ~ filter.id) }}</h1>
            {% if isNew|default(false) %}
                <div class="product-edit-meta">Заповніть поля та натисніть «Зберегти»</div>
            {% else %}
                <div class="product-edit-meta">ID #{{ filter.id }} · {{ filter.category ? filter.category.title : 'Без категорії' }}</div>
            {% endif %}
        </div>
    </div>

    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">{{ form_errors(form) }}</div>
    {% endif %}

    {{ form_start(form, { attr: { class: 'product-edit-form' } }) }}

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Фільтр</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.title) }}</div>
                <div class="col-md-6">{{ form_row(form.category) }}</div>
                <div class="col-md-4">{{ form_row(form.priority) }}</div>
                <div class="col-md-4">{{ form_row(form.openedCount) }}</div>
                <div class="col-md-4 d-flex align-items-end">{{ form_row(form.isOpened) }}</div>
            </div>
        </div>
    </div>

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Параметри</div>
        <div class="card-body">
            {% set attributeBody %}
            <div class="row g-3">
                <div class="col-md-8">{{ form_row(form.attributes.vars.prototype.value) }}</div>
                <div class="col-md-4">{{ form_row(form.attributes.vars.prototype.priority) }}</div>
            </div>
            {% endset %}
            <div id="attributes-collection"
                 data-collapsible-type="filter-attribute"
                 data-prototype="{{ attributeBody|e('html_attr') }}">
                {% for attributeField in form.attributes %}
                    {% set body %}
                    <div class="row g-3">
                        <div class="col-md-8">{{ form_row(attributeField.value) }}</div>
                        <div class="col-md-4">{{ form_row(attributeField.priority) }}</div>
                    </div>
                    {% endset %}
                    {{ collapsible.item('filter-attribute', body, true) }}
                {% endfor %}
            </div>
            <button type="button" class="btn btn-outline-teal btn-sm add-collection-row" data-collection-add="#attributes-collection">
                <i class="bi bi-plus-lg"></i> Додати параметр
            </button>
        </div>
    </div>

    <div class="product-edit-actions">
        <div class="card border-0 px-3 py-2 product-edit-actions__bar">
            <button type="submit" class="btn btn-teal">
                <i class="bi bi-check2"></i> Зберегти
            </button>
            <a href="{{ path('admin2_filters') }}" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin2-collection.js') }}" defer></script>
{% endblock %}
