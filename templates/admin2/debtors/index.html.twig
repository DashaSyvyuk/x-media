{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/debtors/_macros.html.twig' as debt_macros %}

{% block title %}Борги — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/debtors.css') }}">
{% endblock %}

{% block body %}
    {% set query = { q: search, active: activeFilter, sort: sort, dir: direction, perPage: perPage } %}

    <div class="debtors-page">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">Борги</h1>
                <p class="text-muted mb-0 small">Позитивний баланс — вам винні, негативний — ви винні</p>
            </div>
            <button type="button" class="btn btn-teal" data-bs-toggle="modal" data-bs-target="#createDebtorModal">
                <i class="bi bi-plus-lg"></i> Додати контакт
            </button>
        </div>

        <div class="debt-stat-grid">
            <div class="card debt-stat-card">
                <div class="debt-stat-card__body">
                    <div class="debt-stat-card__label">Контактів</div>
                    <div class="debt-stat-card__value">{{ summary.contacts|number_format(0, '.', ' ') }}</div>
                </div>
            </div>
            <div class="card debt-stat-card debt-stat-card--positive">
                <div class="debt-stat-card__body">
                    <div class="debt-stat-card__label">Вам винні</div>
                    {% if summary.owedToYouByCurrency %}
                        <div class="debt-stat-card__values">
                            {% for item in summary.owedToYouByCurrency %}
                                <div class="debt-stat-card__value-line">+{{ item.total|number_format(0, '.', ' ') }} {{ item.code }}</div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="debt-stat-card__value debt-stat-card__value--empty">—</div>
                    {% endif %}
                </div>
            </div>
            <div class="card debt-stat-card debt-stat-card--negative">
                <div class="debt-stat-card__body">
                    <div class="debt-stat-card__label">Ви винні</div>
                    {% if summary.youOweByCurrency %}
                        <div class="debt-stat-card__values">
                            {% for item in summary.youOweByCurrency %}
                                <div class="debt-stat-card__value-line">{{ item.total|number_format(0, '.', ' ') }} {{ item.code }}</div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="debt-stat-card__value debt-stat-card__value--empty">—</div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm products-table-card">
            <div class="card-body p-3 p-md-4 border-bottom">
                <form method="get" action="{{ path('admin2_debtors') }}" class="products-toolbar">
                    <div class="products-toolbar__search">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="search" name="q" value="{{ search }}" class="form-control border-start-0" placeholder="Ім'я контакту">
                        </div>
                    </div>
                    <input type="hidden" name="active" value="{{ activeFilter }}" id="debtorsActiveValue">
                    <div class="admin2-switch debtors-active-filter">
                        <span class="admin2-switch__label" id="debtorsActiveLabel">{{ activeFilter == '1' ? 'Активні' : 'Неактивні' }}</span>
                        <label class="admin2-switch__control" for="debtorsActiveSwitch">
                            <input type="checkbox"
                                   id="debtorsActiveSwitch"
                                   class="admin2-switch__input"
                                   {{ activeFilter == '1' ? 'checked' : '' }}>
                            <span class="admin2-switch__track" aria-hidden="true">
                                <span class="admin2-switch__thumb"></span>
                            </span>
                        </label>
                    </div>
                    <select name="perPage" class="form-select" style="width: auto; min-width: 110px;">
                        {% for option in perPageOptions %}
                            <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }} / стор.</option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="sort" value="{{ sort }}">
                    <input type="hidden" name="dir" value="{{ direction }}">
                    <button type="submit" class="btn btn-teal">Знайти</button>
                    {% if search or activeFilter == '0' %}
                        <a href="{{ path('admin2_debtors') }}" class="btn btn-outline-secondary">Скинути</a>
                    {% endif %}
                </form>
            </div>

            <div class="table-responsive">
                <table class="table products-table align-middle">
                    <thead>
                        <tr>
                            <th>{{ debt_macros.sort_link('ID', 'id', sort, direction, query) }}</th>
                            <th>{{ debt_macros.sort_link('Ім\'я', 'name', sort, direction, query) }}</th>
                            <th>{{ debt_macros.sort_link('Валюта', 'currency', sort, direction, query) }}</th>
                            <th>{{ debt_macros.sort_link('Баланс', 'total', sort, direction, query) }}</th>
                            <th>{{ debt_macros.sort_link('Статус', 'active', sort, direction, query) }}</th>
                            <th style="width: 120px;" class="text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for debtor in pagination %}
                            {% set balance = balances[debtor.id]|default(0) %}
                            {% set symbol = debtor.currency.shortTitle ?: debtor.currency.code %}
                            <tr>
                                <td class="text-muted">#{{ debtor.id }}</td>
                                <td><div class="product-title">{{ debtor.name }}</div></td>
                                <td class="text-muted small">{{ debtor.currency.code }}</td>
                                <td>{{ debt_macros.money(balance, symbol) }}</td>
                                <td>
                                    {% if debtor.active %}
                                        <span class="status-badge status-badge--active">Активний</span>
                                    {% else %}
                                        <span class="status-badge status-badge--blocked">Неактивний</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="table-actions">
                                        <a href="{{ path('admin2_debtors_show', {id: debtor.id}) }}" class="table-action table-action--teal" title="Деталі">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin2_debtors_delete', {id: debtor.id}) ~ (app.request.queryString ? '?' ~ app.request.queryString : '') }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin2_debtor_action') }}">
                                            <button type="submit" class="table-action table-action--danger" title="Видалити" data-confirm="Видалити контакт «{{ debtor.name|e('html_attr') }}»?">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-cash-coin fs-2 d-block mb-2"></i>
                                    Контактів не знайдено
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if pagination.getTotalItemCount() > 0 %}
                <div class="products-footer">
                    <div class="products-summary">
                        Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                        з {{ pagination.getTotalItemCount() }}
                    </div>
                    {% if pagination.pageCount > 1 %}
                        {% set currentPage = pagination.currentPageNumber %}
                        {% set pageCount = pagination.pageCount %}
                        {% set startPage = max(1, currentPage - 2) %}
                        {% set endPage = min(pageCount, currentPage + 2) %}
                        <ul class="products-pagination">
                            <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin2_debtors', query|merge({page: currentPage - 1})) }}"><i class="bi bi-chevron-left"></i></a>
                            </li>
                            {% if startPage > 1 %}
                                {{ debt_macros.page_link(pagination, 1, query) }}
                                {% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                            {% endif %}
                            {% for page in startPage..endPage %}{{ debt_macros.page_link(pagination, page, query) }}{% endfor %}
                            {% if endPage < pageCount %}
                                {% if endPage < pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                                {{ debt_macros.page_link(pagination, pageCount, query) }}
                            {% endif %}
                            <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin2_debtors', query|merge({page: currentPage + 1})) }}"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="modal fade" id="createDebtorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                {{ form_start(createForm, { action: path('admin2_debtors_new'), method: 'POST' }) }}
                <div class="modal-header">
                    <h5 class="modal-title">Новий контакт</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    {{ form_row(createForm.name) }}
                    {{ form_row(createForm.currency) }}
                    {{ form_row(createForm.active) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-teal">Створити</button>
                </div>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.closest('form')?.addEventListener('submit', (event) => {
                if (!window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });

        const activeSwitch = document.getElementById('debtorsActiveSwitch');
        const activeValue = document.getElementById('debtorsActiveValue');
        const activeLabel = document.getElementById('debtorsActiveLabel');
        const toolbarForm = activeSwitch?.closest('form');

        if (activeSwitch && activeValue && toolbarForm) {
            activeSwitch.addEventListener('change', () => {
                const isActive = activeSwitch.checked;
                activeValue.value = isActive ? '1' : '0';
                if (activeLabel) {
                    activeLabel.textContent = isActive ? 'Активні' : 'Неактивні';
                }
                toolbarForm.requestSubmit();
            });
        }
    </script>
{% endblock %}
