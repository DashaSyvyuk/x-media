{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}Коментар #{{ comment.id }} — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/product-edit.css') }}">
{% endblock %}

{% block body %}
    <div class="product-edit-header">
        <div>
            <a href="{{ path('admin2_comments') }}" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> До списку коментарів
            </a>
            <h1 class="page-title mb-1">Коментар #{{ comment.id }}</h1>
            <div class="product-edit-meta">{{ comment.author }} · {{ comment.createdAt|date('d.m.Y H:i') }}</div>
        </div>
    </div>

    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">{{ form_errors(form) }}</div>
    {% endif %}

    {{ form_start(form, { attr: { class: 'product-edit-form' } }) }}

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Коментар</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">{{ form_row(form.author) }}</div>
                <div class="col-md-4">{{ form_row(form.email) }}</div>
                <div class="col-md-4">{{ form_row(form.status) }}</div>
                <div class="col-12">{{ form_row(form.comment) }}</div>
                <div class="col-12">{{ form_row(form.answer) }}</div>
            </div>
        </div>
    </div>

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Товар</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="mb-1 text-muted small">Назва</div>
                    <div class="fw-medium">{{ comment.product.title }}</div>
                </div>
                <div class="col-md-4">
                    <div class="mb-1 text-muted small">ID</div>
                    <div>#{{ comment.product.id }}</div>
                </div>
                <div class="col-12">
                    <a href="{{ path('admin2_products_edit', {id: comment.product.id}) }}" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-box-arrow-up-right"></i> Відкрити товар
                    </a>
                </div>
                {% if comment.productRating %}
                    <div class="col-md-4">
                        <div class="mb-1 text-muted small">Рейтинг</div>
                        <div>{{ comment.productRating.value }}</div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="product-edit-actions">
        <div class="card border-0 px-3 py-2 product-edit-actions__bar">
            <button type="submit" class="btn btn-teal"><i class="bi bi-check2"></i> Зберегти</button>
            <a href="{{ path('admin2_comments') }}" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}
