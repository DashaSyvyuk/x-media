{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/price_control/_macros.html.twig' as price_macros %}

{% block title %}Контроль цін — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/price-control.css') }}">
{% endblock %}

{% block body %}
    {% set query = {
        q: search,
        status: status,
        category: categoryId,
        sort: sort,
        dir: direction,
        perPage: perPage,
    } %}

    <div class="price-control-page">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">Контроль цін</h1>
                <p class="text-muted mb-0 small">Швидке редагування цін сайту та Rozetka прямо в таблиці</p>
            </div>
            <a href="{{ path('admin2_products') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-seam"></i> До товарів
            </a>
        </div>

        <div class="card border-0 shadow-sm products-table-card mb-4">
            <div class="card-body p-3 p-md-4">
                <form method="get" action="{{ path('admin2_price_control') }}" class="products-toolbar">
                    <div class="products-toolbar__search">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="search" name="q" value="{{ search }}" class="form-control border-start-0" placeholder="ID, назва або код">
                        </div>
                    </div>
                    <select name="status" class="form-select" style="width: auto; min-width: 150px;">
                        <option value="">Усі статуси</option>
                        {% for value, label in statuses %}
                            <option value="{{ value }}" {{ status == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                    <select name="category" class="form-select" style="width: auto; min-width: 180px;">
                        <option value="">Усі категорії</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}" {{ categoryId == category.id ? 'selected' : '' }}>{{ category.title }}</option>
                        {% endfor %}
                    </select>
                    <select name="perPage" class="form-select" style="width: auto; min-width: 110px;">
                        {% for option in perPageOptions %}
                            <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }} / стор.</option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="sort" value="{{ sort }}">
                    <input type="hidden" name="dir" value="{{ direction }}">
                    <button type="submit" class="btn btn-teal">Знайти</button>
                    {% if search or status or categoryId %}
                        <a href="{{ path('admin2_price_control') }}" class="btn btn-outline-secondary">Скинути</a>
                    {% endif %}
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm products-table-card">
            <div class="table-responsive">
                <table id="priceControlTable"
                       class="table products-table price-control-table align-middle"
                       data-update-url="{{ path('admin2_price_control_update') }}"
                       data-xkom-url-update-url="{{ path('admin2_price_control_xkom_url') }}"
                       data-update-token="{{ updateToken }}">
                    <thead>
                        <tr>
                            <th>{{ price_macros.sort_link('ID', 'id', sort, direction, query) }}</th>
                            <th>{{ price_macros.sort_link('Назва', 'title', sort, direction, query) }}</th>
                            <th>Категорія</th>
                            <th>Код</th>
                            <th class="col-price">{{ price_macros.sort_link('Ціна', 'price', sort, direction, query) }}</th>
                            <th class="col-old-price"><span class="strike">Ціна</span></th>
                            <th class="col-rozetka">Rozetka</th>
                            <th class="col-rozetka-old"><span class="strike">Rozetka</span></th>
                            <th class="col-xkom">x-kom</th>
                            <th>Статус</th>
                            <th class="text-end">Дія</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in pagination %}
                            {% set rozetka = product.rozetka %}
                            {% set isActive = product.status == constant('App\\Entity\\Product::STATUS_ACTIVE') %}
                            {% set isOldBad = product.crossedOutPrice is not null and product.crossedOutPrice <= product.price %}
                            {% set isRzOldBad = rozetka and rozetka.crossedOutPrice is not null and rozetka.price is not null and rozetka.crossedOutPrice <= rozetka.price %}
                            {% set isRzTooClose = rozetka and rozetka.price is not null and rozetka.price > product.price and rozetka.price <= (product.price * 1.05) %}
                            <tr data-id="{{ product.id }}" data-status="{{ product.status }}">
                                <td class="text-muted">#{{ product.id }}</td>
                                <td>
                                    <div class="product-title-wrap">
                                        <span class="product-title product-title--full">{{ product.title }}</span>
                                        <a href="/products/{{ product.id }}" target="_blank" rel="noopener" class="product-title-link" title="На сайті">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                    <a href="{{ path('admin2_products_edit', {id: product.id}) }}" class="small text-decoration-none">Редагувати</a>
                                </td>
                                <td class="small text-muted">{{ product.category ? product.category.title : '—' }}</td>
                                <td class="code-cell">
                                    {% if product.productCode %}<code>{{ product.productCode }}</code>{% else %}—{% endif %}
                                    {% if product.productCode2 %}<br><code class="text-muted">{{ product.productCode2 }}</code>{% endif %}
                                </td>
                                <td class="col-price" data-field="price">
                                    <input type="number" class="form-control form-control-sm cell-input" value="{{ product.price }}" min="0" step="1">
                                </td>
                                <td class="col-old-price {{ isOldBad ? 'cell-bad' : '' }}" data-field="crossed_out_price">
                                    <input type="number" class="form-control form-control-sm cell-input strike" value="{{ product.crossedOutPrice ?? '' }}" min="0" step="1" placeholder="—">
                                </td>
                                <td class="col-rozetka {{ isRzTooClose ? 'cell-bad' : '' }}" data-field="rozetka_price">
                                    <input type="number" class="form-control form-control-sm cell-input" value="{{ rozetka ? rozetka.price ?? '' : '' }}" min="0" step="1" placeholder="—" {% if not rozetka %}disabled{% endif %}>
                                </td>
                                <td class="col-rozetka-old {{ isRzOldBad ? 'cell-bad' : '' }}" data-field="rozetka_crossed_out_price">
                                    <input type="number" class="form-control form-control-sm cell-input strike" value="{{ rozetka ? rozetka.crossedOutPrice ?? '' : '' }}" min="0" step="1" placeholder="—" {% if not rozetka %}disabled{% endif %}>
                                </td>
                                {% set xkom = product.xkomUrl ? (xkomInfo[product.id]|default(null)) : null %}
                                <td class="col-xkom" title="{{ xkom and xkom.title ? xkom.title : '' }}">
                                    {% if product.xkomUrl %}
                                        {% if xkom %}
                                            {% if xkom.available and xkom.price is not null %}
                                                <strong>{{ xkom.price|number_format(0, '.', ' ') }} zl</strong>
                                                {% if plnRate and plnRate > 0 %}
                                                    {% set calcUah = (xkom.price / 1.23 * plnRate * 1.08) %}
                                                    <div class="xkom-calc">
                                                        {{ calcUah|number_format(0, '.', ' ') }} грн
                                                    </div>
                                                {% endif %}
                                            {% else %}
                                                <span class="xkom-unavailable">Недоступний</span>
                                                {% if xkom.price is not null %}
                                                    <span class="xkom-old-price">{{ xkom.price|number_format(0, '.', ' ') }} zl</span>
                                                {% endif %}
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted small">—</span>
                                        {% endif %}
                                        <a href="{{ product.xkomUrl }}" target="_blank" rel="noopener" class="product-title-link ms-1" title="x-kom">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    {% else %}
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary js-xkom-url-edit"
                                                data-product-id="{{ product.id }}"
                                                title="Додати посилання x-kom">
                                            <i class="bi bi-link-45deg"></i>
                                        </button>
                                    {% endif %}
                                </td>
                                <td>
                                    <label class="admin2-switch__control">
                                        <input type="checkbox" class="admin2-switch__input js-status-switch" {% if isActive %}checked{% endif %}>
                                        <span class="admin2-switch__track" aria-hidden="true"><span class="admin2-switch__thumb"></span></span>
                                    </label>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-teal save-btn js-price-save" disabled>Зберегти</button>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="11" class="text-center text-muted py-5">Товарів не знайдено</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if pagination.getTotalItemCount() > 0 %}
                <div class="products-footer">
                    <div class="products-summary">
                        Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                        з {{ pagination.getTotalItemCount() }}
                    </div>
                    {% if pagination.pageCount > 1 %}
                        {% set currentPage = pagination.currentPageNumber %}
                        {% set pageCount = pagination.pageCount %}
                        {% set startPage = max(1, currentPage - 2) %}
                        {% set endPage = min(pageCount, currentPage + 2) %}
                        <ul class="products-pagination">
                            <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin2_price_control', query|merge({page: currentPage - 1})) }}"><i class="bi bi-chevron-left"></i></a>
                            </li>
                            {% if startPage > 1 %}{{ price_macros.page_link(pagination, 1, query) }}{% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}{% endif %}
                            {% for page in startPage..endPage %}{{ price_macros.page_link(pagination, page, query) }}{% endfor %}
                            {% if endPage < pageCount %}{% if endPage < pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}{{ price_macros.page_link(pagination, pageCount, query) }}{% endif %}
                            <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin2_price_control', query|merge({page: currentPage + 1})) }}"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin2-price-control.js') }}" defer></script>

    <div class="modal fade" id="xkomUrlModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Посилання x-kom</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="xkomUrlProductId" value="">
                    <label class="form-label" for="xkomUrlInput">URL</label>
                    <input type="url" class="form-control" id="xkomUrlInput" placeholder="https://www.x-kom.pl/p/...">
                    <div class="form-text">Вставте посилання на товар з `x-kom.pl`.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Закрити</button>
                    <button type="button" class="btn btn-teal" id="xkomUrlSaveBtn">Зберегти</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
