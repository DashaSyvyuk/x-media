{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}{{ isNew ? 'Новий постачальник' : supplier.title }} — X-media Admin{% endblock %}

{% block body %}
    <a href="{{ path('admin2_suppliers') }}" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> До постачальників
    </a>

    <h1 class="page-title mb-4">{{ isNew ? 'Новий постачальник' : supplier.title }}</h1>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ form_start(form) }}
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.title) }}</div>
                <div class="col-md-3">{{ form_row(form.name) }}</div>
                <div class="col-md-3">{{ form_row(form.surname) }}</div>
                <div class="col-md-4">{{ form_row(form.phone) }}</div>
                <div class="col-md-4">{{ form_row(form.email) }}</div>
                <div class="col-md-4">{{ form_row(form.orderStorageDays) }}</div>
                <div class="col-md-6">{{ form_row(form.address) }}</div>
                <div class="col-md-3">{{ form_row(form.bankAccount) }}</div>
                <div class="col-md-3">{{ form_row(form.currency) }}</div>
                <div class="col-md-3 d-flex align-items-end">{{ form_row(form.active) }}</div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-teal">Зберегти</button>
                <a href="{{ path('admin2_suppliers') }}" class="btn btn-outline-secondary">Скасувати</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
