{% macro sort_link(label, field, currentSort, currentDir, query) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    {% set params = query|merge({sort: field, dir: nextDir, page: 1}) %}
    <a href="{{ path('admin2_rozetka', params) }}" class="sort-link {{ currentSort == field ? 'active' : '' }}">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-chevron-{{ currentDir == 'ASC' ? 'up' : 'down' }}"></i>
        {% endif %}
    </a>
{% endmacro %}

{% macro page_link(pagination, page, query) %}
    {% set params = query|merge({page: page}) %}
    <li class="page-item {{ page == pagination.currentPageNumber ? 'active' : '' }}">
        <a class="page-link" href="{{ path('admin2_rozetka', params) }}">{{ page }}</a>
    </li>
{% endmacro %}

{% macro money(value) %}
    {% if value is not null %}
        {{ value|number_format(0, '.', ' ') }} ₴
    {% else %}
        —
    {% endif %}
{% endmacro %}

{% macro inline_switch(id, field, checked, disabled) %}
    <label class="admin2-switch__control rozetka-inline-switch {{ disabled ? 'is-disabled' : '' }}">
        <input type="checkbox"
               class="admin2-switch__input js-rozetka-toggle"
               data-id="{{ id }}"
               data-field="{{ field }}"
               {% if checked %}checked{% endif %}
               {% if disabled %}disabled{% endif %}>
        <span class="admin2-switch__track" aria-hidden="true">
            <span class="admin2-switch__thumb"></span>
        </span>
    </label>
{% endmacro %}
