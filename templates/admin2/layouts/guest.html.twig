<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block title %}X-media — Вхід{% endblock %}</title>
    {% include 'admin2/partials/pwa-head.html.twig' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/admin2/app.css') }}">
</head>
<body class="auth-page">
    <nav class="navbar navbar-dark shadow-sm app-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold mb-0 d-flex align-items-center gap-2" href="{{ path('admin2_login') }}">
                <span class="brand-icon"><i class="bi bi-shop"></i></span>
                X-media
            </a>
        </div>
    </nav>

    <div class="auth-wrapper">
        <div class="card border-0 shadow-sm auth-card">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h1 class="auth-title mb-1">{% block auth_title %}Вхід{% endblock %}</h1>
                    <p class="auth-subtitle mb-0">{% block auth_subtitle %}Адмін-панель інтернет-магазину{% endblock %}</p>
                </div>

                {% block body %}{% endblock %}
            </div>
        </div>
    </div>

    <script src="{{ asset('js/admin2-pwa.js') }}" defer></script>
</body>
</html>
