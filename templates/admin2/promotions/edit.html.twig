{% extends 'admin2/layouts/base.html.twig' %}

{% import 'admin2/products/_collapsible_collection_item.html.twig' as collapsible %}

{% block title %}{{ isNew|default(false) ? 'Нова акція' : 'Редагування #' ~ promotion.id }} — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/product-edit.css') }}">
{% endblock %}

{% block body %}
    <div class="product-edit-header">
        <div>
            <a href="{{ path('admin2_promotions') }}" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> До списку акцій
            </a>
            <h1 class="page-title mb-1">{{ promotion.title ?: (isNew|default(false) ? 'Нова акція' : 'Акція #' ~ promotion.id) }}</h1>
            {% if isNew|default(false) %}
                <div class="product-edit-meta">Заповніть поля та натисніть «Зберегти»</div>
            {% else %}
                <div class="product-edit-meta">ID #{{ promotion.id }} · /promotion/{{ promotion.slug }}</div>
            {% endif %}
        </div>
        {% if not isNew|default(false) and promotion.slug %}
            <a href="/promotion/{{ promotion.slug }}" target="_blank" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-arrow-up-right"></i> На сайті
            </a>
        {% endif %}
    </div>

    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">{{ form_errors(form) }}</div>
    {% endif %}

    {{ form_start(form, { attr: { class: 'product-edit-form' } }) }}

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Акція</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.title) }}</div>
                <div class="col-md-6">{{ form_row(form.slug) }}</div>
                <div class="col-12">{{ form_row(form.description) }}</div>
                <div class="col-md-4">{{ form_row(form.status) }}</div>
                <div class="col-md-4">{{ form_row(form.activeFrom) }}</div>
                <div class="col-md-4">{{ form_row(form.activeTo) }}</div>
            </div>
        </div>
    </div>

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Товари</div>
        <div class="card-body">
            {% set productBody %}
            <div class="row g-3">
                <div class="col-12">{{ form_row(form.products.vars.prototype.product) }}</div>
            </div>
            {% endset %}
            <div id="products-collection"
                 data-collapsible-type="promotion-product"
                 data-prototype="{{ productBody|e('html_attr') }}">
                {% for productField in form.products %}
                    {% set promotionProduct = productField.vars.data %}
                    {% set body %}
                    <div class="row g-3">
                        <div class="col-md-4">{{ form_row(productField.product) }}</div>
                        <div class="col-md-8 d-flex align-items-end">
                            {% if promotionProduct and promotionProduct.product %}
                                <span class="text-muted small" data-product-label>#{{ promotionProduct.product.id }} · {{ promotionProduct.product.title }}</span>
                            {% else %}
                                <span class="text-muted small" data-product-label></span>
                            {% endif %}
                        </div>
                    </div>
                    {% endset %}
                    {{ collapsible.item('promotion-product', body, true) }}
                {% endfor %}
            </div>
            <button type="button" class="btn btn-outline-teal btn-sm add-collection-row" data-collection-add="#products-collection">
                <i class="bi bi-plus-lg"></i> Додати товар
            </button>
        </div>
    </div>

    <div class="product-edit-actions">
        <div class="card border-0 px-3 py-2 product-edit-actions__bar">
            <button type="submit" class="btn btn-teal"><i class="bi bi-check2"></i> Зберегти</button>
            <a href="{{ path('admin2_promotions') }}" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin2-collection.js') }}" defer></script>
{% endblock %}
