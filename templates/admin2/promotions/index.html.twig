{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/promotions/_macros.html.twig' as promo_macros %}

{% block title %}Акції — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
{% endblock %}

{% block body %}
    {% set query = { q: search, sort: sort, dir: direction, perPage: perPage } %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Акції</h1>
            <p class="text-muted mb-0 small">Промо-сторінки та товари в акціях</p>
        </div>
        <a href="{{ path('admin2_promotions_new') }}" class="btn btn-teal">
            <i class="bi bi-plus-lg"></i> Нова акція
        </a>
    </div>

    <div class="card border-0 shadow-sm products-table-card">
        <div class="card-body p-3 p-md-4 border-bottom">
            <form method="get" action="{{ path('admin2_promotions') }}" class="products-toolbar">
                <div class="products-toolbar__search">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="search" name="q" value="{{ search }}" class="form-control border-start-0" placeholder="Назва або slug">
                    </div>
                </div>
                <select name="perPage" class="form-select" style="width: auto; min-width: 110px;">
                    {% for option in perPageOptions %}
                        <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }} / стор.</option>
                    {% endfor %}
                </select>
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ direction }}">
                <button type="submit" class="btn btn-teal">Знайти</button>
                {% if search %}
                    <a href="{{ path('admin2_promotions') }}" class="btn btn-outline-secondary">Скинути</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive">
            <table class="table products-table align-middle">
                <thead>
                    <tr>
                        <th>{{ promo_macros.sort_link('ID', 'id', sort, direction, query) }}</th>
                        <th>{{ promo_macros.sort_link('Назва', 'title', sort, direction, query) }}</th>
                        <th>{{ promo_macros.sort_link('Slug', 'slug', sort, direction, query) }}</th>
                        <th>{{ promo_macros.sort_link('Статус', 'status', sort, direction, query) }}</th>
                        <th>{{ promo_macros.sort_link('З', 'activeFrom', sort, direction, query) }}</th>
                        <th>{{ promo_macros.sort_link('До', 'activeTo', sort, direction, query) }}</th>
                        <th>Товарів</th>
                        <th style="width: 100px;" class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    {% for promotion in pagination %}
                        <tr>
                            <td class="text-muted">#{{ promotion.id }}</td>
                            <td><div class="product-title">{{ promotion.title }}</div></td>
                            <td class="text-muted small">{{ promotion.slug }}</td>
                            <td>{{ promo_macros.status_badge(promotion.status) }}</td>
                            <td class="small text-muted">{{ promotion.activeFrom|date('d.m.Y H:i') }}</td>
                            <td class="small text-muted">{{ promotion.activeTo|date('d.m.Y H:i') }}</td>
                            <td>{{ productCounts[promotion.id]|default(0) }}</td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a href="{{ path('admin2_promotions_edit', {id: promotion.id}) }}" class="table-action table-action--teal" title="Редагувати">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin2_promotions_delete', {id: promotion.id}) ~ (app.request.queryString ? '?' ~ app.request.queryString : '') }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_promotion_action') }}">
                                        <button type="submit" class="table-action table-action--danger" title="Видалити" data-confirm="Видалити акцію «{{ promotion.title|e('html_attr') }}»?">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-tag fs-2 d-block mb-2"></i>
                                Акцій не знайдено
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.getTotalItemCount() > 0 %}
            <div class="products-footer">
                <div class="products-summary">
                    Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                    з {{ pagination.getTotalItemCount() }}
                </div>
                {% if pagination.pageCount > 1 %}
                    {% set currentPage = pagination.currentPageNumber %}
                    {% set pageCount = pagination.pageCount %}
                    {% set startPage = max(1, currentPage - 2) %}
                    {% set endPage = min(pageCount, currentPage + 2) %}
                    <ul class="products-pagination">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_promotions', query|merge({page: currentPage - 1})) }}"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        {% if startPage > 1 %}
                            {{ promo_macros.page_link(pagination, 1, query) }}
                            {% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                        {% endif %}
                        {% for page in startPage..endPage %}{{ promo_macros.page_link(pagination, page, query) }}{% endfor %}
                        {% if endPage < pageCount %}
                            {% if endPage < pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                            {{ promo_macros.page_link(pagination, pageCount, query) }}
                        {% endif %}
                        <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_promotions', query|merge({page: currentPage + 1})) }}"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.closest('form')?.addEventListener('submit', (event) => {
                if (!window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
{% endblock %}
