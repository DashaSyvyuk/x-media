{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}Склади — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 page-header-row">
        <div>
            <h1 class="page-title mb-1">Склади</h1>
            <p class="text-muted mb-0 small">Список складів для обліку наявності</p>
        </div>
        <a href="{{ path('admin2_warehouses_new') }}" class="btn btn-teal"><i class="bi bi-plus-lg"></i> Новий склад</a>
    </div>

    <div class="card border-0 shadow-sm products-table-card">
        <div class="card-body p-3 border-bottom">
            <form method="get" class="products-toolbar">
                <div class="products-toolbar__search">
                    <input type="search" name="q" value="{{ search }}" class="form-control" placeholder="Назва, місто, адреса...">
                </div>
                <select name="active" class="form-select" style="width:auto;">
                    <option value="">Усі</option>
                    <option value="1" {{ activeFilter == '1' ? 'selected' : '' }}>Активні</option>
                    <option value="0" {{ activeFilter == '0' ? 'selected' : '' }}>Неактивні</option>
                </select>
                <button class="btn btn-teal" type="submit">Фільтр</button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 products-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Назва</th>
                        <th>Місто</th>
                        <th>Кількість</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for warehouse in pagination %}
                        <tr>
                            <td>{{ warehouse.id }}</td>
                            <td><strong>{{ warehouse.title }}</strong></td>
                            <td>{{ warehouse.city ?: '—' }}</td>
                            <td>{{ stockTotals[warehouse.id]|default(0)|number_format(0, '.', ' ') }}</td>
                            <td>
                                {% if warehouse.active %}
                                    <span class="badge bg-success-subtle text-success-emphasis">Активний</span>
                                {% else %}
                                    <span class="badge bg-secondary">Неактивний</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('admin2_warehouses_edit', {id: warehouse.id}) }}" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-5">Складів не знайдено</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
