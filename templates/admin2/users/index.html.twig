{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/users/_macros.html.twig' as user_macros %}

{% block title %}Користувачі — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
{% endblock %}

{% block body %}
    {% set query = { q: search, sort: sort, dir: direction, perPage: perPage } %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Користувачі</h1>
            <p class="text-muted mb-0 small">Облікові записи клієнтів</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm products-table-card">
        <div class="card-body p-3 p-md-4 border-bottom">
            <form method="get" action="{{ path('admin2_users') }}" class="products-toolbar">
                <div class="products-toolbar__search">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="search" name="q" value="{{ search }}" class="form-control border-start-0" placeholder="Ім'я, телефон, email">
                    </div>
                </div>
                <select name="perPage" class="form-select" style="width: auto; min-width: 110px;">
                    {% for option in perPageOptions %}
                        <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }} / стор.</option>
                    {% endfor %}
                </select>
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ direction }}">
                <button type="submit" class="btn btn-teal">Знайти</button>
                {% if search %}
                    <a href="{{ path('admin2_users') }}" class="btn btn-outline-secondary">Скинути</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive">
            <table class="table products-table products-table--mobile-cards align-middle">
                <thead>
                    <tr>
                        <th>{{ user_macros.sort_link('ID', 'id', sort, direction, query) }}</th>
                        <th>{{ user_macros.sort_link('Ім\'я', 'name', sort, direction, query) }}</th>
                        <th>{{ user_macros.sort_link('Прізвище', 'surname', sort, direction, query) }}</th>
                        <th>{{ user_macros.sort_link('Телефон', 'phone', sort, direction, query) }}</th>
                        <th>{{ user_macros.sort_link('Email', 'email', sort, direction, query) }}</th>
                        <th>{{ user_macros.sort_link('Дата', 'createdAt', sort, direction, query) }}</th>
                        <th style="width: 100px;" class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in pagination %}
                        <tr>
                            <td class="text-muted" data-label="ID">#{{ user.id }}</td>
                            <td data-label="Ім'я"><div class="product-title">{{ user.name }}</div></td>
                            <td data-label="Прізвище">{{ user.surname }}</td>
                            <td class="text-muted small" data-label="Телефон">{{ user.phone }}</td>
                            <td class="text-muted small" data-label="Email">{{ user.email }}</td>
                            <td class="small text-muted" data-label="Дата">{{ user.createdAt|date('d.m.Y H:i') }}</td>
                            <td class="text-end col-actions" data-label="">
                                <div class="table-actions">
                                    <a href="{{ path('admin2_users_edit', {id: user.id}) }}" class="table-action table-action--teal" title="Редагувати">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin2_users_delete', {id: user.id}) ~ (app.request.queryString ? '?' ~ app.request.queryString : '') }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_user_action') }}">
                                        <button type="submit" class="table-action table-action--danger" title="Видалити" data-confirm="Видалити користувача #{{ user.id }}?">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-people fs-2 d-block mb-2"></i>
                                Користувачів не знайдено
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.getTotalItemCount() > 0 %}
            <div class="products-footer">
                <div class="products-summary">
                    Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                    з {{ pagination.getTotalItemCount() }}
                </div>
                {% if pagination.pageCount > 1 %}
                    {% set currentPage = pagination.currentPageNumber %}
                    {% set pageCount = pagination.pageCount %}
                    {% set startPage = max(1, currentPage - 2) %}
                    {% set endPage = min(pageCount, currentPage + 2) %}
                    <ul class="products-pagination">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_users', query|merge({page: currentPage - 1})) }}"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        {% if startPage > 1 %}
                            {{ user_macros.page_link(pagination, 1, query) }}
                            {% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                        {% endif %}
                        {% for page in startPage..endPage %}{{ user_macros.page_link(pagination, page, query) }}{% endfor %}
                        {% if endPage < pageCount %}
                            {% if endPage < pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                            {{ user_macros.page_link(pagination, pageCount, query) }}
                        {% endif %}
                        <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_users', query|merge({page: currentPage + 1})) }}"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.closest('form')?.addEventListener('submit', (event) => {
                if (!window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
{% endblock %}
