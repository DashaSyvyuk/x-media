{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/orders/_macros.html.twig' as order_macros %}

{% block title %}Користувач #{{ user.id }} — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/product-edit.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin2/orders.css') }}">
{% endblock %}

{% block body %}
    <div class="product-edit-header">
        <div>
            <a href="{{ path('admin2_users') }}" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> До списку користувачів
            </a>
            <h1 class="page-title mb-1">{{ user.name }} {{ user.surname }}</h1>
            <div class="product-edit-meta">{{ user.email }} · {{ user.phone }}</div>
        </div>
    </div>

    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">{{ form_errors(form) }}</div>
    {% endif %}

    {{ form_start(form, { attr: { class: 'product-edit-form' } }) }}

    <div class="card product-edit-section shadow-sm">
        <div class="card-header">Профіль</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">{{ form_row(form.name) }}</div>
                <div class="col-md-4">{{ form_row(form.surname) }}</div>
                <div class="col-md-4">{{ form_row(form.phone) }}</div>
                <div class="col-md-6">{{ form_row(form.email) }}</div>
                <div class="col-md-6 d-flex align-items-end">{{ form_row(form.confirmed) }}</div>
                <div class="col-12">{{ form_row(form.address) }}</div>
                <div class="col-md-6">{{ form_row(form.novaPoshtaCity) }}</div>
                <div class="col-md-6">{{ form_row(form.novaPoshtaOffice) }}</div>
            </div>
        </div>
    </div>

    {% if user.orders|length > 0 %}
        <div class="card product-edit-section shadow-sm user-orders-table">
            <div class="card-header">Замовлення ({{ user.orders|length }})</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table products-table products-table--mobile-cards align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Номер</th>
                                <th>Статус</th>
                                <th>Сума</th>
                                <th>Дата</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in user.orders %}
                                <tr>
                                    <td data-label="Номер">{{ order.orderNumber }}</td>
                                    <td data-label="Статус">{{ order_macros.order_status_badge(order.status) }}</td>
                                    <td data-label="Сума">{{ order_macros.money(order.total) }}</td>
                                    <td class="small text-muted" data-label="Дата">{{ order.createdAt|date('d.m.Y H:i') }}</td>
                                    <td class="text-end col-actions" data-label="">
                                        <a href="{{ path('admin2_orders_edit', {id: order.id}) }}" class="btn btn-sm btn-outline-teal">Відкрити</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="product-edit-actions">
        <div class="card border-0 px-3 py-2 product-edit-actions__bar">
            <button type="submit" class="btn btn-teal"><i class="bi bi-check2"></i> Зберегти</button>
            <a href="{{ path('admin2_users') }}" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}
