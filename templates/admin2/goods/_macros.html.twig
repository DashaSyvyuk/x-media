{% macro money(value) -%}
    {{- value|number_format(2, '.', ' ') -}} ₴
{%- endmacro %}

{% macro money_signed(value) -%}
    {%- if value > 0 -%}+{% endif -%}
    {{- value|number_format(2, '.', ' ') -}} ₴
{%- endmacro %}

{% macro month_ua(date) -%}
    {%- set months = {
        1: 'січ', 2: 'лют', 3: 'бер', 4: 'кві', 5: 'тра', 6: 'чер',
        7: 'лип', 8: 'сер', 9: 'вер', 10: 'жов', 11: 'лис', 12: 'гру'
    } -%}
    {{- months[date|date('n')] }} {{ date|date('Y') -}}
{%- endmacro %}
