{# Batch modals #}
<div class="modal fade" id="createPlanningGoodBatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" action="{{ path('admin2_goods_batches_create') }}" class="modal-content">
            <input type="hidden" name="_token" value="{{ csrf_token('admin2_goods') }}">
            <input type="hidden" name="view" value="grouped">
            <div class="modal-header">
                <h2 class="modal-title h5 mb-0">Новий блок</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрити"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="createPlanningGoodBatchDate">Дата</label>
                    <input type="date" name="recorded_date" id="createPlanningGoodBatchDate" class="form-control" value="{{ 'now'|date('Y-m-d') }}" required>
                </div>
                <div class="mb-0">
                    <label class="form-label" for="createPlanningGoodBatchName">Назва</label>
                    <input type="text" name="name" id="createPlanningGoodBatchName" class="form-control" maxlength="255" placeholder="Необовʼязково">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                <button type="submit" class="btn btn-teal">Створити</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editPlanningGoodBatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="editPlanningGoodBatchForm" action="" class="modal-content">
