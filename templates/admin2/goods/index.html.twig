{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}Товар — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/goods.css') }}">
{% endblock %}

{% block body %}
    <div class="planning-goods-page">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="page-title mb-1">Товар</h1>
                <p class="text-muted mb-0 small">Блоки з датою та таблицею товарів у кожному</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                {% if view == 'grouped' %}
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#createPlanningGoodBatchModal">
                        <i class="bi bi-collection me-1"></i>
                        Новий блок
                    </button>
                {% endif %}
                {% if view == 'all' and batches is not empty %}
                    <button type="button" class="btn btn-teal" data-bs-toggle="modal" data-bs-target="#createPlanningGoodModal">
                        <i class="bi bi-plus-lg me-1"></i>
                        Додати товар
                    </button>
                {% endif %}
            </div>
        </div>

        <div class="planning-goods-view-tabs">
            <a href="{{ path('admin2_goods', {view: 'grouped'}) }}"
               class="btn btn-filter {{ view == 'grouped' ? 'active' : '' }}">
                <i class="bi bi-collection me-1"></i>
                Блоки
            </a>
            <a href="{{ path('admin2_goods', {view: 'all'}) }}"
               class="btn btn-filter {{ view == 'all' ? 'active' : '' }}">
                <i class="bi bi-table me-1"></i>
                Усі разом
            </a>
        </div>

        {% if view == 'grouped' %}
            {% if batches is empty %}
                <div class="planning-empty">
                    <i class="bi bi-collection"></i>
                    <p class="mb-3">Блоків ще немає. Створіть перший блок з датою.</p>
                    <button type="button" class="btn btn-teal" data-bs-toggle="modal" data-bs-target="#createPlanningGoodBatchModal">
                        Новий блок
                    </button>
                </div>
            {% else %}
                <div class="planning-goods-blocks">
                    {% for batch in batches %}
                        {% include 'admin2/goods/_block.html.twig' with {
                            batch: batch,
                            isOpen: openBatchId == batch.id or (openBatchId == 0 and loop.first),
                            view: view
                        } only %}
                    {% endfor %}
                </div>

                {% if goods is not empty %}
                    <section class="planning-goods-grand-total card border-0 shadow-sm mt-3">
                        <div class="card-body">
                            <h2 class="h6 mb-3">Загалом по всіх блоках</h2>
                            {% include 'admin2/goods/_totals.html.twig' with { totals: totals, variant: 'grand' } only %}
                        </div>
                    </section>
                {% endif %}
            {% endif %}
        {% elseif goods is empty %}
            <div class="planning-empty">
                <i class="bi bi-box-seam"></i>
                <p class="mb-0">Товарів ще немає.</p>
            </div>
        {% else %}
            {% include 'admin2/goods/_table.html.twig' with {
                goods: goods,
                totals: totals,
                showDateColumn: true,
                showBlockColumn: true
            } only %}
        {% endif %}
    </div>

    {% include 'admin2/goods/_modals.html.twig' %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin2-goods.js') }}" defer></script>
{% endblock %}
