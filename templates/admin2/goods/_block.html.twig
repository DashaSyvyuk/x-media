{% import 'admin2/goods/_macros.html.twig' as goods_macros %}
{% set batchTotals = batch.totals %}
{% set isFullySold = batchTotals.count > 0 and batchTotals.sold_count == batchTotals.count %}

<article class="planning-goods-block {{ isOpen ? 'is-open' : '' }} {{ isFullySold ? 'is-sold-out' : '' }}">
    <div class="planning-goods-block__header">
        <button type="button"
                class="planning-goods-block__toggle"
                data-goods-block-toggle
                aria-expanded="{{ isOpen ? 'true' : 'false' }}">
            <div class="planning-goods-block__date">
                <span class="planning-goods-block__day">{{ batch.recordedDate|date('d') }}</span>
                <span class="planning-goods-block__month">{{ goods_macros.month_ua(batch.recordedDate) }}</span>
            </div>
            <div class="planning-goods-block__body">
                <strong class="planning-goods-block__title">{{ batch.displayName }}</strong>
                <div class="planning-goods-block__meta">
                    {{ batchTotals.count }}
                    {{ batchTotals.count == 1 ? 'товар' : 'товари' }}
                    {% if batchTotals.margin != 0 %}
                        · {{ goods_macros.money_signed(batchTotals.margin) }}
                    {% endif %}
                </div>
            </div>
            <i class="bi bi-chevron-down planning-goods-block__chevron"></i>
        </button>

        <div class="planning-goods-block__actions">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-bs-toggle="modal"
                    data-bs-target="#editPlanningGoodBatchModal"
                    data-id="{{ batch.id }}"
                    data-name="{{ batch.name ?? '' }}"
                    data-recorded-date="{{ batch.recordedDate|date('Y-m-d') }}"
                    title="Редагувати блок">
                <i class="bi bi-pencil"></i>
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deletePlanningGoodBatchModal"
                    data-id="{{ batch.id }}"
                    data-name="{{ batch.displayName }}"
                    title="Видалити блок">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>

    <div class="planning-goods-block__panel">
        <div class="planning-goods-block__panel-inner">
            {% if batch.goods is empty %}
                <div class="planning-goods-block__empty text-muted">У цьому блоці ще немає товарів.</div>
            {% else %}
                {% include 'admin2/goods/_table.html.twig' with {
                    goods: batch.goods,
                    totals: batchTotals,
                    showDateColumn: false,
                    showBlockColumn: false
                } only %}
            {% endif %}

            <div class="planning-goods-block__footer">
                <button type="button"
                        class="btn btn-sm btn-teal"
                        data-bs-toggle="modal"
                        data-bs-target="#createPlanningGoodModal"
                        data-batch-id="{{ batch.id }}">
                    <i class="bi bi-plus-lg me-1"></i>
                    Додати товар
                </button>
            </div>
        </div>
    </div>
</article>
