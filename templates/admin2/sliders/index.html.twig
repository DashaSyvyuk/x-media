{% extends 'admin2/layouts/base.html.twig' %}
{% import 'admin2/sliders/_macros.html.twig' as slider_macros %}

{% block title %}Слайдер — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/products.css') }}">
{% endblock %}

{% block body %}
    {% set query = { q: search, sort: sort, dir: direction, perPage: perPage } %}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Слайдер</h1>
            <p class="text-muted mb-0 small">Банери на головній сторінці</p>
        </div>
        <a href="{{ path('admin2_sliders_new') }}" class="btn btn-teal">
            <i class="bi bi-plus-lg"></i> Новий слайд
        </a>
    </div>

    <div class="card border-0 shadow-sm products-table-card">
        <div class="card-body p-3 p-md-4 border-bottom">
            <form method="get" action="{{ path('admin2_sliders') }}" class="products-toolbar">
                <div class="products-toolbar__search">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="search" name="q" value="{{ search }}" class="form-control border-start-0" placeholder="Заголовок">
                    </div>
                </div>
                <select name="perPage" class="form-select" style="width: auto; min-width: 110px;">
                    {% for option in perPageOptions %}
                        <option value="{{ option }}" {{ perPage == option ? 'selected' : '' }}>{{ option }} / стор.</option>
                    {% endfor %}
                </select>
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ direction }}">
                <button type="submit" class="btn btn-teal">Знайти</button>
                {% if search %}
                    <a href="{{ path('admin2_sliders') }}" class="btn btn-outline-secondary">Скинути</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive">
            <table class="table products-table align-middle">
                <thead>
                    <tr>
                        <th>{{ slider_macros.sort_link('ID', 'id', sort, direction, query) }}</th>
                        <th style="width: 80px;">Картинка</th>
                        <th>{{ slider_macros.sort_link('Заголовок', 'title', sort, direction, query) }}</th>
                        <th>{{ slider_macros.sort_link('Пріоритет', 'priority', sort, direction, query) }}</th>
                        <th>{{ slider_macros.sort_link('Показувати', 'active', sort, direction, query) }}</th>
                        <th>Акція</th>
                        <th style="width: 100px;" class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    {% for slider in pagination %}
                        <tr>
                            <td class="text-muted">#{{ slider.id }}</td>
                            <td>
                                {% if slider.imageUri %}
                                    <img src="{{ slider.imageUri }}" alt="" class="product-image-preview" style="max-height: 48px;">
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="product-title">{{ slider.title ?: '—' }}</div>
                                {% if slider.url %}
                                    <div class="product-title__meta text-truncate" style="max-width: 240px;">{{ slider.url }}</div>
                                {% endif %}
                            </td>
                            <td>{{ slider.priority ?? '—' }}</td>
                            <td>
                                {% if slider.active %}
                                    <span class="status-badge status-badge--active">Так</span>
                                {% else %}
                                    <span class="status-badge status-badge--blocked">Ні</span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">{{ slider.promotion ? slider.promotion.title : '—' }}</td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a href="{{ path('admin2_sliders_edit', {id: slider.id}) }}" class="table-action table-action--teal" title="Редагувати">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin2_sliders_delete', {id: slider.id}) ~ (app.request.queryString ? '?' ~ app.request.queryString : '') }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_slider_action') }}">
                                        <button type="submit" class="table-action table-action--danger" title="Видалити" data-confirm="Видалити слайд «{{ (slider.title ?: '#' ~ slider.id)|e('html_attr') }}»?">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-images fs-2 d-block mb-2"></i>
                                Слайдів не знайдено
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.getTotalItemCount() > 0 %}
            <div class="products-footer">
                <div class="products-summary">
                    Показано {{ pagination.getPaginationData()['firstItemNumber'] }}–{{ pagination.getPaginationData()['lastItemNumber'] }}
                    з {{ pagination.getTotalItemCount() }}
                </div>
                {% if pagination.pageCount > 1 %}
                    {% set currentPage = pagination.currentPageNumber %}
                    {% set pageCount = pagination.pageCount %}
                    {% set startPage = max(1, currentPage - 2) %}
                    {% set endPage = min(pageCount, currentPage + 2) %}
                    <ul class="products-pagination">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_sliders', query|merge({page: currentPage - 1})) }}"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        {% if startPage > 1 %}
                            {{ slider_macros.page_link(pagination, 1, query) }}
                            {% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                        {% endif %}
                        {% for page in startPage..endPage %}{{ slider_macros.page_link(pagination, page, query) }}{% endfor %}
                        {% if endPage < pageCount %}
                            {% if endPage < pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                            {{ slider_macros.page_link(pagination, pageCount, query) }}
                        {% endif %}
                        <li class="page-item {{ currentPage == pageCount ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('admin2_sliders', query|merge({page: currentPage + 1})) }}"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.querySelectorAll('[data-confirm]').forEach((button) => {
            button.closest('form')?.addEventListener('submit', (event) => {
                if (!window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
{% endblock %}
