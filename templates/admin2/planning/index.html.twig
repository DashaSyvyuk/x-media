{% extends 'admin2/layouts/base.html.twig' %}

{% block title %}Планування — X-media Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin2/planning.css') }}">
{% endblock %}

{% block body %}
    {% set boardColor = activeBoard.colorHex %}
    {% set todayKey = today|date('Y-m-d') %}
    {% set totalCards = 0 %}
    {% for colPlans in columns %}
        {% set totalCards = totalCards + colPlans|length %}
    {% endfor %}

    <div class="planning-page" style="--board-accent: {{ boardColor }}">
        <div class="planning-page-header">
            <div>
                <h1 class="page-title mb-1">Планування</h1>
                <p class="text-muted mb-0 small">Дошки · стовпці · картки. З датою і незавершеним стовпцем — на головній.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#createBoardModal">
                    <i class="bi bi-layout-sidebar"></i> Нова дошка
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#createColumnModal">
                    <i class="bi bi-layout-three-columns"></i> Новий стовпець
                </button>
                <button type="button" class="btn btn-teal" data-bs-toggle="modal" data-bs-target="#createPlanModal">
                    <i class="bi bi-plus-lg"></i> Нова картка
                </button>
            </div>
        </div>

        <div class="planning-shell">
            <aside class="planning-boards">
                <div class="planning-boards__head">
                    <span>Дошки</span>
                    <button type="button"
                            class="btn btn-sm btn-link planning-boards__add"
                            data-bs-toggle="modal"
                            data-bs-target="#createBoardModal"
                            title="Нова дошка">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <nav class="planning-boards__list" aria-label="Дошки">
                    {% for board in boards %}
                        {% set isActive = board.id == activeBoard.id %}
                        <div class="planning-board-item {{ isActive ? 'is-active' : '' }}" style="--board-color: {{ board.colorHex }}">
                            <a href="{{ path('admin2_planning', {board: board.id}) }}"
                               class="planning-board-item__link"
                               {% if isActive %}aria-current="page"{% endif %}>
                                <span class="planning-board-item__dot"></span>
                                <span class="planning-board-item__title">{{ board.title }}</span>
                            </a>
                            <div class="planning-board-item__actions">
                                <form method="post" action="{{ path('admin2_planning_board_move', {id: board.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin2_plan_board') }}">
                                    <input type="hidden" name="direction" value="up">
                                    <button type="submit" class="btn btn-sm btn-link p-0" title="Вище" {% if loop.first %}disabled{% endif %}>
                                        <i class="bi bi-chevron-up"></i>
                                    </button>
                                </form>
                                <form method="post" action="{{ path('admin2_planning_board_move', {id: board.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin2_plan_board') }}">
                                    <input type="hidden" name="direction" value="down">
                                    <button type="submit" class="btn btn-sm btn-link p-0" title="Нижче" {% if loop.last %}disabled{% endif %}>
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                </form>
                                {% if isActive %}
                                    <button type="button"
                                            class="btn btn-sm btn-link p-0 js-edit-board"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editBoardModal"
                                            data-id="{{ board.id }}"
                                            data-title="{{ board.title|e('html_attr') }}"
                                            data-color="{{ board.color }}"
                                            title="Редагувати дошку">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </nav>
            </aside>

            <div class="planning-main">
                <div class="planning-main__head">
                    <div class="planning-main__title-wrap">
                        <span class="planning-main__accent"></span>
                        <div>
                            <h2 class="planning-main__title">{{ activeBoard.title }}</h2>
                            <p class="planning-main__hint mb-0">
                                {{ totalCards }} {{ totalCards == 1 ? 'картка' : 'карток' }}
                                · {{ boardColumns|length }} {{ boardColumns|length == 1 ? 'стовпець' : 'стовпців' }}
                            </p>
                        </div>
                    </div>
                    <div class="planning-top-tabs d-md-none">
                        {% for board in boards %}
                            <a href="{{ path('admin2_planning', {board: board.id}) }}"
                               class="planning-top-tab {{ board.id == activeBoard.id ? 'is-active' : '' }}"
                               style="--board-color: {{ board.colorHex }}">
                                {{ board.title }}
                            </a>
                        {% endfor %}
                    </div>
                </div>

                <div class="planning-kanban"
                     data-csrf="{{ csrf_token('admin2_plan_action') }}"
                     data-columns="{{ columnMeta|json_encode|e('html_attr') }}">
                    {% for column in boardColumns %}
                        {% set colPlans = columns[column.id]|default([]) %}
                        <section class="planning-column"
                                 data-status="{{ column.id }}"
                                 data-column-id="{{ column.id }}"
                                 style="--col-color: {{ column.colorHex }}">
                            <header class="planning-column__head">
                                <span class="planning-column__dot"></span>
                                <h3 class="planning-column__title">
                                    {{ column.title }}
                                    {% if column.isDone %}
                                        <span class="planning-column__done-tag">готово</span>
                                    {% endif %}
                                </h3>
                                <span class="planning-column__count">{{ colPlans|length }}</span>
                                <div class="planning-column__actions">
                                    <form method="post"
                                          action="{{ path('admin2_planning_column_move', {id: column.id}) }}"
                                          class="planning-column__action-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_plan_column') }}">
                                        <input type="hidden" name="direction" value="up">
                                        <button type="submit"
                                                class="planning-column__icon-btn"
                                                title="Ліворуч"
                                                {% if loop.first %}disabled{% endif %}>
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                    </form>
                                    <form method="post"
                                          action="{{ path('admin2_planning_column_move', {id: column.id}) }}"
                                          class="planning-column__action-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_plan_column') }}">
                                        <input type="hidden" name="direction" value="down">
                                        <button type="submit"
                                                class="planning-column__icon-btn"
                                                title="Праворуч"
                                                {% if loop.last %}disabled{% endif %}>
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </form>
                                    <button type="button"
                                            class="planning-column__icon-btn js-edit-column"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editColumnModal"
                                            data-id="{{ column.id }}"
                                            data-title="{{ column.title|e('html_attr') }}"
                                            data-color="{{ column.color }}"
                                            data-done="{{ column.isDone ? '1' : '0' }}"
                                            title="Редагувати стовпець">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post"
                                          action="{{ path('admin2_planning_column_delete', {id: column.id}) }}"
                                          class="planning-column__action-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin2_plan_column') }}">
                                        <button type="submit"
                                                class="planning-column__icon-btn planning-column__icon-btn--danger"
                                                data-confirm="Видалити стовпець «{{ column.title|e('html_attr') }}»? Він має бути порожнім."
                                                title="Видалити стовпець"
                                                {% if boardColumns|length <= 1 %}disabled{% endif %}>
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </div>
                            </header>

                            <div class="planning-column__cards">
                                {% if colPlans is empty %}
                                    <div class="planning-column__empty">Порожньо</div>
                                {% else %}
                                    {% for plan in colPlans %}
                                        {% include 'admin2/planning/_card.html.twig' with {
                                            plan: plan,
                                            column: column,
                                            boardColumns: boardColumns,
                                            today: today,
                                            todayKey: todayKey,
                                            isFirst: loop.first,
                                            isLast: loop.last,
                                            boardId: activeBoard.id
                                        } %}
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </section>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    {% include 'admin2/planning/_modals.html.twig' %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin2-planning.js') }}" defer></script>
{% endblock %}
